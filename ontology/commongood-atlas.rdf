    <rdfs:label>Status</rdfs:label>
    <rdfs:comment>Whether the sponsoring organization has acted on the Grant Recommendation.</rdfs:comment>
    <rdfs:domain rdf:resource="https://egovender.github.io/commongood-atlas/ontology/grant-recommendation" />
    <npo:group>lifecycle</npo:group>
    <npo:required>true</npo:required>
    <npo:cardinality>one</npo:cardinality>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty" />
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
    <npo:allowedValue>pending</npo:allowedValue>
    <npo:allowedValue>approved</npo:allowedValue>
    <npo:allowedValue>declined</npo:allowedValue>
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/properties/indirect-cost-rate-rate">
    <rdfs:label>Rate</rdfs:label>
    <rdfs:comment>The indirect cost rate, expressed as a percentage of direct costs.</rdfs:comment>
    <rdfs:domain rdf:resource="https://egovender.github.io/commongood-atlas/ontology/indirect-cost-rate" />
    <npo:group>financial</npo:group>
    <npo:required>true</npo:required>
    <npo:cardinality>one</npo:cardinality>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty" />
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/properties/indirect-cost-rate-rate-type">
    <rdfs:label>Rate Type</rdfs:label>
    <rdfs:comment>Whether the rate was individually negotiated or is the de minimis rate.</rdfs:comment>
    <rdfs:domain rdf:resource="https://egovender.github.io/commongood-atlas/ontology/indirect-cost-rate" />
    <npo:group>classification</npo:group>
    <npo:required>true</npo:required>
    <npo:cardinality>one</npo:cardinality>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty" />
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
    <npo:allowedValue>negotiated</npo:allowedValue>
    <npo:allowedValue>de-minimis</npo:allowedValue>
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/properties/installment-amount">
    <rdfs:label>Amount</rdfs:label>
    <rdfs:comment>The amount scheduled for this Installment.</rdfs:comment>
    <rdfs:domain rdf:resource="https://egovender.github.io/commongood-atlas/ontology/installment" />
    <npo:group>financial</npo:group>
    <npo:required>true</npo:required>
    <npo:cardinality>one</npo:cardinality>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty" />
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/properties/installment-status">
    <rdfs:label>Status</rdfs:label>
    <rdfs:comment>Whether the Installment has been disbursed, or is being held pending its Payment Condition.</rdfs:comment>
    <rdfs:domain rdf:resource="https://egovender.github.io/commongood-atlas/ontology/installment" />
    <npo:group>lifecycle</npo:group>
    <npo:required>true</npo:required>
    <npo:cardinality>one</npo:cardinality>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty" />
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
    <npo:allowedValue>scheduled</npo:allowedValue>
    <npo:allowedValue>released</npo:allowedValue>
    <npo:allowedValue>held</npo:allowedValue>
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/properties/letter-of-inquiry-status">
    <rdfs:label>Status</rdfs:label>
    <rdfs:comment>Whether the Letter of Inquiry resulted in an invitation to submit a full Application.</rdfs:comment>
    <rdfs:domain rdf:resource="https://egovender.github.io/commongood-atlas/ontology/letter-of-inquiry" />
    <npo:group>lifecycle</npo:group>
    <npo:required>true</npo:required>
    <npo:cardinality>one</npo:cardinality>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty" />
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
    <npo:allowedValue>submitted</npo:allowedValue>
    <npo:allowedValue>invited</npo:allowedValue>
    <npo:allowedValue>declined</npo:allowedValue>
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/properties/matching-requirement-match-type">
    <rdfs:label>Match Type</rdfs:label>
    <rdfs:comment>Whether the required match must be cash or may be in-kind.</rdfs:comment>
    <rdfs:domain rdf:resource="https://egovender.github.io/commongood-atlas/ontology/matching-requirement" />
    <npo:group>financial</npo:group>
    <npo:required>true</npo:required>
    <npo:cardinality>one</npo:cardinality>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty" />
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
    <npo:allowedValue>cash</npo:allowedValue>
    <npo:allowedValue>in-kind</npo:allowedValue>
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/properties/matching-requirement-required-ratio">
    <rdfs:label>Required Ratio</rdfs:label>
    <rdfs:comment>The match ratio the Grantee must meet, e.g. "1:1".</rdfs:comment>
    <rdfs:domain rdf:resource="https://egovender.github.io/commongood-atlas/ontology/matching-requirement" />
    <npo:group>financial</npo:group>
    <npo:required>true</npo:required>
    <npo:cardinality>one</npo:cardinality>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty" />
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/properties/measurement-observation-date">
    <rdfs:label>Observation Date</rdfs:label>
    <rdfs:comment>The date the value was observed.</rdfs:comment>
    <rdfs:domain rdf:resource="https://egovender.github.io/commongood-atlas/ontology/measurement" />
    <npo:group>lifecycle</npo:group>
    <npo:required>true</npo:required>
    <npo:cardinality>one</npo:cardinality>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty" />
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/properties/measurement-value">
    <rdfs:label>Value</rdfs:label>
    <rdfs:comment>The observed value for the indicator. A plain string so it can hold a numeric ("64%"), categorical ("improved"), ordinal ("high"), or textual observation without conflating these kinds of values into different fields.</rdfs:comment>
    <rdfs:domain rdf:resource="https://egovender.github.io/commongood-atlas/ontology/measurement" />
    <npo:group>lifecycle</npo:group>
    <npo:required>true</npo:required>
    <npo:cardinality>one</npo:cardinality>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty" />
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/properties/organization-formation-date">
    <rdfs:label>Formation Date</rdfs:label>
    <rdfs:comment>When the organization was legally formed.</rdfs:comment>
    <rdfs:domain rdf:resource="https://egovender.github.io/commongood-atlas/ontology/organization" />
    <npo:group>lifecycle</npo:group>
    <npo:required>false</npo:required>
    <npo:cardinality>one</npo:cardinality>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty" />
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/properties/organization-identifier">
    <rdfs:label>Identifier</rdfs:label>
    <rdfs:comment>A registration number or unique identifier for the organization (e.g., an EIN or DUNS number), if tracked.</rdfs:comment>
    <rdfs:domain rdf:resource="https://egovender.github.io/commongood-atlas/ontology/organization" />
    <npo:group>classification</npo:group>
    <npo:required>false</npo:required>
    <npo:cardinality>one</npo:cardinality>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty" />
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/properties/organization-jurisdiction">
    <rdfs:label>Jurisdiction</rdfs:label>
    <rdfs:comment>The legal jurisdiction (country or state) the organization is formed and regulated under.</rdfs:comment>
    <rdfs:domain rdf:resource="https://egovender.github.io/commongood-atlas/ontology/organization" />
    <npo:group>classification</npo:group>
    <npo:required>false</npo:required>
    <npo:cardinality>one</npo:cardinality>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty" />
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/properties/organization-operating-status">
    <rdfs:label>Operating Status</rdfs:label>
    <rdfs:comment>Whether the organization is currently operating.</rdfs:comment>
    <rdfs:domain rdf:resource="https://egovender.github.io/commongood-atlas/ontology/organization" />
    <npo:group>lifecycle</npo:group>
    <npo:required>false</npo:required>
    <npo:cardinality>one</npo:cardinality>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty" />
    <rdfs:range rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
    <npo:referenceScheme rdf:resource="https://egovender.github.io/commongood-atlas/ontology/reference-data/organization-operating-status" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/properties/organization-tax-identifier">
    <rdfs:label>Tax Identifier</rdfs:label>
    <rdfs:comment>The organization's tax identification number (e.g., an EIN), if applicable and disclosed.</rdfs:comment>
    <rdfs:domain rdf:resource="https://egovender.github.io/commongood-atlas/ontology/organization" />
    <npo:group>classification</npo:group>
    <npo:required>false</npo:required>
    <npo:cardinality>one</npo:cardinality>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty" />
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/properties/organization-tax-status">
    <rdfs:label>Tax Status</rdfs:label>
    <rdfs:comment>The organization's tax-exemption status, independent of its legal form.</rdfs:comment>
    <rdfs:domain rdf:resource="https://egovender.github.io/commongood-atlas/ontology/organization" />
    <npo:group>classification</npo:group>
    <npo:required>false</npo:required>
    <npo:cardinality>one</npo:cardinality>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty" />
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
    <npo:allowedValue>tax-exempt-501c3</npo:allowedValue>
    <npo:allowedValue>tax-exempt-other</npo:allowedValue>
    <npo:allowedValue>taxable</npo:allowedValue>
    <npo:allowedValue>government-exempt</npo:allowedValue>
    <npo:allowedValue>unknown</npo:allowedValue>
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/properties/output-unit">
    <rdfs:label>Unit</rdfs:label>
    <rdfs:comment>The unit the Output is counted in, e.g. "workshops" or "people served".</rdfs:comment>
    <rdfs:domain rdf:resource="https://egovender.github.io/commongood-atlas/ontology/output" />
    <npo:group>classification</npo:group>
    <npo:required>false</npo:required>
    <npo:cardinality>one</npo:cardinality>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty" />
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/properties/payment-amount">
    <rdfs:label>Amount</rdfs:label>
    <rdfs:comment>The actual amount transferred in this Payment.</rdfs:comment>
    <rdfs:domain rdf:resource="https://egovender.github.io/commongood-atlas/ontology/payment" />
    <npo:group>financial</npo:group>
    <npo:required>true</npo:required>
    <npo:cardinality>one</npo:cardinality>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty" />
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/properties/payment-condition-condition-type">
    <rdfs:label>Condition Type</rdfs:label>
    <rdfs:comment>What kind of condition must be satisfied before the corresponding Payment is released.</rdfs:comment>
    <rdfs:domain rdf:resource="https://egovender.github.io/commongood-atlas/ontology/payment-condition" />
    <npo:group>governance</npo:group>
    <npo:required>true</npo:required>
    <npo:cardinality>one</npo:cardinality>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty" />
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
    <npo:allowedValue>report-required</npo:allowedValue>
    <npo:allowedValue>milestone-required</npo:allowedValue>
    <npo:allowedValue>none</npo:allowedValue>
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/properties/payment-currency">
    <rdfs:label>Currency</rdfs:label>
    <rdfs:comment>The currency the Payment was made in, if not implied by context.</rdfs:comment>
    <rdfs:domain rdf:resource="https://egovender.github.io/commongood-atlas/ontology/payment" />
    <npo:group>financial</npo:group>
    <npo:required>false</npo:required>
    <npo:cardinality>one</npo:cardinality>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty" />
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/properties/payment-date">
    <rdfs:label>Payment Date</rdfs:label>
    <rdfs:comment>When the Payment was sent or received.</rdfs:comment>
    <rdfs:domain rdf:resource="https://egovender.github.io/commongood-atlas/ontology/payment" />
    <npo:group>lifecycle</npo:group>
    <npo:required>false</npo:required>
    <npo:cardinality>one</npo:cardinality>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty" />
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/properties/payment-schedule-status">
    <rdfs:label>Status</rdfs:label>
    <rdfs:comment>Whether all Installments in the Payment Schedule have been disbursed.</rdfs:comment>
    <rdfs:domain rdf:resource="https://egovender.github.io/commongood-atlas/ontology/payment-schedule" />
    <npo:group>lifecycle</npo:group>
    <npo:required>true</npo:required>
    <npo:cardinality>one</npo:cardinality>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty" />
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
    <npo:allowedValue>active</npo:allowedValue>
    <npo:allowedValue>completed</npo:allowedValue>
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/properties/payment-status">
    <rdfs:label>Status</rdfs:label>
    <rdfs:comment>Where the Payment stands in transit.</rdfs:comment>
    <rdfs:domain rdf:resource="https://egovender.github.io/commongood-atlas/ontology/payment" />
    <npo:group>lifecycle</npo:group>
    <npo:required>true</npo:required>
    <npo:cardinality>one</npo:cardinality>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty" />
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
    <npo:allowedValue>pending</npo:allowedValue>
    <npo:allowedValue>sent</npo:allowedValue>
    <npo:allowedValue>received</npo:allowedValue>
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/properties/philanthropic-arrangement-effective-date">
    <rdfs:label>Effective Date</rdfs:label>
    <rdfs:comment>When the arrangement took effect.</rdfs:comment>
    <rdfs:domain rdf:resource="https://egovender.github.io/commongood-atlas/ontology/philanthropic-arrangement" />
    <npo:group>lifecycle</npo:group>
    <npo:required>false</npo:required>
    <npo:cardinality>one</npo:cardinality>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty" />
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/properties/philanthropic-arrangement-governing-document">
    <rdfs:label>Governing Document</rdfs:label>
    <rdfs:comment>The name or type of document that formally establishes the arrangement (e.g., a fiscal sponsorship agreement).</rdfs:comment>
    <rdfs:domain rdf:resource="https://egovender.github.io/commongood-atlas/ontology/philanthropic-arrangement" />
    <npo:group>governance</npo:group>
    <npo:required>false</npo:required>
    <npo:cardinality>one</npo:cardinality>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty" />
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/properties/philanthropic-arrangement-status">
    <rdfs:label>Status</rdfs:label>
    <rdfs:comment>Whether the arrangement is currently active.</rdfs:comment>
    <rdfs:domain rdf:resource="https://egovender.github.io/commongood-atlas/ontology/philanthropic-arrangement" />
    <npo:group>lifecycle</npo:group>
    <npo:required>true</npo:required>
    <npo:cardinality>one</npo:cardinality>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty" />
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
    <npo:allowedValue>active</npo:allowedValue>
    <npo:allowedValue>terminated</npo:allowedValue>
    <npo:allowedValue>pending</npo:allowedValue>
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/properties/philanthropic-arrangement-termination-date">
    <rdfs:label>Termination Date</rdfs:label>
    <rdfs:comment>When the arrangement ended, if it has.</rdfs:comment>
    <rdfs:domain rdf:resource="https://egovender.github.io/commongood-atlas/ontology/philanthropic-arrangement" />
    <npo:group>lifecycle</npo:group>
    <npo:required>false</npo:required>
    <npo:cardinality>one</npo:cardinality>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty" />
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/properties/project-issue-area">
    <rdfs:label>Issue Area</rdfs:label>
    <rdfs:comment>The primary social or environmental issue this Project addresses.</rdfs:comment>
    <rdfs:domain rdf:resource="https://egovender.github.io/commongood-atlas/ontology/project" />
    <npo:group>classification</npo:group>
    <npo:required>false</npo:required>
    <npo:cardinality>one</npo:cardinality>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty" />
    <rdfs:range rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
    <npo:referenceScheme rdf:resource="https://egovender.github.io/commongood-atlas/ontology/reference-data/issue-area" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/properties/report-due-date">
    <rdfs:label>Due Date</rdfs:label>
    <rdfs:comment>When the Report is due per the Reporting Schedule.</rdfs:comment>
    <rdfs:domain rdf:resource="https://egovender.github.io/commongood-atlas/ontology/report" />
    <npo:group>lifecycle</npo:group>
    <npo:required>true</npo:required>
    <npo:cardinality>one</npo:cardinality>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty" />
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/properties/report-report-type">
    <rdfs:label>Report Type</rdfs:label>
    <rdfs:comment>Whether the Report covers narrative progress, financial use of funds, or both.</rdfs:comment>
    <rdfs:domain rdf:resource="https://egovender.github.io/commongood-atlas/ontology/report" />
    <npo:group>classification</npo:group>
    <npo:required>true</npo:required>
    <npo:cardinality>one</npo:cardinality>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty" />
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
    <npo:allowedValue>narrative</npo:allowedValue>
    <npo:allowedValue>financial</npo:allowedValue>
    <npo:allowedValue>both</npo:allowedValue>
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/properties/report-status">
    <rdfs:label>Status</rdfs:label>
    <rdfs:comment>Where the Report stands with the funder.</rdfs:comment>
    <rdfs:domain rdf:resource="https://egovender.github.io/commongood-atlas/ontology/report" />
    <npo:group>lifecycle</npo:group>
    <npo:required>true</npo:required>
    <npo:cardinality>one</npo:cardinality>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty" />
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
    <npo:allowedValue>not-started</npo:allowedValue>
    <npo:allowedValue>submitted</npo:allowedValue>
    <npo:allowedValue>accepted</npo:allowedValue>
    <npo:allowedValue>rejected</npo:allowedValue>
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/properties/report-submitted-date">
    <rdfs:label>Submitted Date</rdfs:label>
    <rdfs:comment>When the Report was actually submitted, once it has been.</rdfs:comment>
    <rdfs:domain rdf:resource="https://egovender.github.io/commongood-atlas/ontology/report" />
    <npo:group>lifecycle</npo:group>
    <npo:required>false</npo:required>
    <npo:cardinality>one</npo:cardinality>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty" />
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/properties/reporting-schedule-frequency">
    <rdfs:label>Frequency</rdfs:label>
    <rdfs:comment>How often Reports are due under this Reporting Schedule.</rdfs:comment>
    <rdfs:domain rdf:resource="https://egovender.github.io/commongood-atlas/ontology/reporting-schedule" />
    <npo:group>lifecycle</npo:group>
    <npo:required>true</npo:required>
    <npo:cardinality>one</npo:cardinality>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty" />
    <rdfs:range rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
    <npo:referenceScheme rdf:resource="https://egovender.github.io/commongood-atlas/ontology/reference-data/frequency" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/properties/review-status">
    <rdfs:label>Status</rdfs:label>
    <rdfs:comment>Where the Review currently stands.</rdfs:comment>
    <rdfs:domain rdf:resource="https://egovender.github.io/commongood-atlas/ontology/review" />
    <npo:group>lifecycle</npo:group>
    <npo:required>true</npo:required>
    <npo:cardinality>one</npo:cardinality>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty" />
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
    <npo:allowedValue>pending</npo:allowedValue>
    <npo:allowedValue>in-progress</npo:allowedValue>
    <npo:allowedValue>completed</npo:allowedValue>
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/properties/role-effective-from">
    <rdfs:label>Effective From</rdfs:label>
    <rdfs:comment>When this role occupancy takes effect. Inherited by every Person Role and Organization Role subclass.</rdfs:comment>
    <rdfs:domain rdf:resource="https://egovender.github.io/commongood-atlas/ontology/role" />
    <npo:group>lifecycle</npo:group>
    <npo:required>false</npo:required>
    <npo:cardinality>one</npo:cardinality>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty" />
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/properties/role-effective-to">
    <rdfs:label>Effective To</rdfs:label>
    <rdfs:comment>When this role occupancy ends, if it has a defined end. Must not precede Effective From.</rdfs:comment>
    <rdfs:domain rdf:resource="https://egovender.github.io/commongood-atlas/ontology/role" />
    <npo:group>lifecycle</npo:group>
    <npo:required>false</npo:required>
    <npo:cardinality>one</npo:cardinality>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty" />
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/properties/role-notes">
    <rdfs:label>Notes</rdfs:label>
    <rdfs:comment>Free-text context about this role occupancy not captured by its other properties.</rdfs:comment>
    <rdfs:domain rdf:resource="https://egovender.github.io/commongood-atlas/ontology/role" />
    <npo:group>governance</npo:group>
    <npo:required>false</npo:required>
    <npo:cardinality>one</npo:cardinality>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty" />
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/properties/role-scope">
    <rdfs:label>Scope</rdfs:label>
    <rdfs:comment>How narrowly this role occupancy is scoped. A plain inline enum until Phase 3.7 Milestone 3's reference-data framework exists, at which point this becomes a governed vocabulary instead.</rdfs:comment>
    <rdfs:domain rdf:resource="https://egovender.github.io/commongood-atlas/ontology/role" />
    <npo:group>governance</npo:group>
    <npo:required>false</npo:required>
    <npo:cardinality>one</npo:cardinality>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty" />
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
    <npo:allowedValue>organization-wide</npo:allowedValue>
    <npo:allowedValue>program-specific</npo:allowedValue>
    <npo:allowedValue>project-specific</npo:allowedValue>
    <npo:allowedValue>award-specific</npo:allowedValue>
    <npo:allowedValue>agreement-specific</npo:allowedValue>
    <npo:allowedValue>arrangement-specific</npo:allowedValue>
    <npo:allowedValue>transaction-specific</npo:allowedValue>
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/properties/role-status">
    <rdfs:label>Status</rdfs:label>
    <rdfs:comment>Where this role occupancy currently sits in its own lifecycle.</rdfs:comment>
    <rdfs:domain rdf:resource="https://egovender.github.io/commongood-atlas/ontology/role" />
    <npo:group>lifecycle</npo:group>
    <npo:required>true</npo:required>
    <npo:cardinality>one</npo:cardinality>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty" />
    <rdfs:range rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
    <npo:referenceScheme rdf:resource="https://egovender.github.io/commongood-atlas/ontology/reference-data/role-status" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/properties/site-visit-scheduled-date">
    <rdfs:label>Scheduled Date</rdfs:label>
    <rdfs:comment>When the Site Visit is scheduled to occur.</rdfs:comment>
    <rdfs:domain rdf:resource="https://egovender.github.io/commongood-atlas/ontology/site-visit" />
    <npo:group>lifecycle</npo:group>
    <npo:required>true</npo:required>
    <npo:cardinality>one</npo:cardinality>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty" />
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/properties/site-visit-status">
    <rdfs:label>Status</rdfs:label>
    <rdfs:comment>Whether the Site Visit has happened yet.</rdfs:comment>
    <rdfs:domain rdf:resource="https://egovender.github.io/commongood-atlas/ontology/site-visit" />
    <npo:group>lifecycle</npo:group>
    <npo:required>true</npo:required>
    <npo:cardinality>one</npo:cardinality>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty" />
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
    <npo:allowedValue>scheduled</npo:allowedValue>
    <npo:allowedValue>completed</npo:allowedValue>
    <npo:allowedValue>cancelled</npo:allowedValue>
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/properties/sponsored-project-end-date">
    <rdfs:label>End Date</rdfs:label>
    <rdfs:comment>When the Sponsored Project ended, if it has.</rdfs:comment>
    <rdfs:domain rdf:resource="https://egovender.github.io/commongood-atlas/ontology/sponsored-project" />
    <npo:group>lifecycle</npo:group>
    <npo:required>false</npo:required>
    <npo:cardinality>one</npo:cardinality>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty" />
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/properties/sponsored-project-start-date">
    <rdfs:label>Start Date</rdfs:label>
    <rdfs:comment>When the Sponsored Project began operating under its Fiscal Sponsor.</rdfs:comment>
    <rdfs:domain rdf:resource="https://egovender.github.io/commongood-atlas/ontology/sponsored-project" />
    <npo:group>lifecycle</npo:group>
    <npo:required>false</npo:required>
    <npo:cardinality>one</npo:cardinality>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty" />
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/properties/sponsored-project-status">
    <rdfs:label>Status</rdfs:label>
    <rdfs:comment>Whether the Sponsored Project is still operating under its Fiscal Sponsor.</rdfs:comment>
    <rdfs:domain rdf:resource="https://egovender.github.io/commongood-atlas/ontology/sponsored-project" />
    <npo:group>lifecycle</npo:group>
    <npo:required>true</npo:required>
    <npo:cardinality>one</npo:cardinality>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty" />
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
    <npo:allowedValue>active</npo:allowedValue>
    <npo:allowedValue>completed</npo:allowedValue>
    <npo:allowedValue>terminated</npo:allowedValue>
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/properties/target-target-date">
    <rdfs:label>Target Date</rdfs:label>
    <rdfs:comment>The date by which the target value is expected to be reached.</rdfs:comment>
    <rdfs:domain rdf:resource="https://egovender.github.io/commongood-atlas/ontology/target" />
    <npo:group>lifecycle</npo:group>
    <npo:required>true</npo:required>
    <npo:cardinality>one</npo:cardinality>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty" />
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/properties/target-value">
    <rdfs:label>Value</rdfs:label>
    <rdfs:comment>The planned value for the indicator (e.g. "70%", "500 households"). A plain string so it can hold a numeric, percentage, or other planned value without a separate typed field per kind of indicator.</rdfs:comment>
    <rdfs:domain rdf:resource="https://egovender.github.io/commongood-atlas/ontology/target" />
    <npo:group>lifecycle</npo:group>
    <npo:required>true</npo:required>
    <npo:cardinality>one</npo:cardinality>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty" />
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/properties/terms-and-conditions-restriction-type">
    <rdfs:label>Restriction Type</rdfs:label>
    <rdfs:comment>Whether the funding governed by these Terms and Conditions is Restricted or Unrestricted Funding.</rdfs:comment>
    <rdfs:domain rdf:resource="https://egovender.github.io/commongood-atlas/ontology/terms-and-conditions" />
    <npo:group>governance</npo:group>
    <npo:required>true</npo:required>
    <npo:cardinality>one</npo:cardinality>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty" />
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
    <npo:allowedValue>restricted</npo:allowedValue>
    <npo:allowedValue>unrestricted</npo:allowedValue>
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/rules/rule-active-role-requires-effective-from">
    <rdf:type rdf:resource="https://egovender.github.io/commongood-atlas/ontology/BusinessRule" />
    <rdfs:label>An active role must have an effective start date</rdfs:label>
    <rdfs:comment>A Role occupancy with status Active must specify Effective From -- a role cannot be considered in effect without a defined start.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://github.com/EGovender/commongood-atlas/blob/main/docs/02-core-concepts.md#organizational-entities" />
    <npo:appliesTo rdf:resource="https://egovender.github.io/commongood-atlas/ontology/role" />
    <npo:appliesTo rdf:resource="https://egovender.github.io/commongood-atlas/ontology/person-role" />
    <npo:appliesTo rdf:resource="https://egovender.github.io/commongood-atlas/ontology/organization-role" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/rules/rule-amendment-not-retroactive">
    <rdf:type rdf:resource="https://egovender.github.io/commongood-atlas/ontology/BusinessRule" />
    <rdfs:label>An Amendment is forward-looking, not retroactive</rdfs:label>
    <rdfs:comment>An Amendment changes the Grant Agreement going forward; it does not retroactively alter Payments or Reports already completed under the prior terms.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://github.com/EGovender/commongood-atlas/blob/main/docs/03-relationships.md#key-relationship-rules-draft" />
    <npo:appliesTo rdf:resource="https://egovender.github.io/commongood-atlas/ontology/amendment" />
    <npo:appliesTo rdf:resource="https://egovender.github.io/commongood-atlas/ontology/grant-agreement" />
    <npo:appliesTo rdf:resource="https://egovender.github.io/commongood-atlas/ontology/payment" />
    <npo:appliesTo rdf:resource="https://egovender.github.io/commongood-atlas/ontology/report" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/rules/rule-award-requires-approved-decision">
    <rdf:type rdf:resource="https://egovender.github.io/commongood-atlas/ontology/BusinessRule" />
    <rdfs:label>An Award requires an approved Decision</rdfs:label>
    <rdfs:comment>An Award cannot exist without a Decision that approved an Application (or, in funder-initiated giving, an equivalent internal approval).</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://github.com/EGovender/commongood-atlas/blob/main/docs/03-relationships.md#key-relationship-rules-draft" />
    <npo:appliesTo rdf:resource="https://egovender.github.io/commongood-atlas/ontology/award" />
    <npo:appliesTo rdf:resource="https://egovender.github.io/commongood-atlas/ontology/decision" />
    <npo:appliesTo rdf:resource="https://egovender.github.io/commongood-atlas/ontology/application" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/rules/rule-closeout-requires-payments-and-reports">
    <rdf:type rdf:resource="https://egovender.github.io/commongood-atlas/ontology/BusinessRule" />
    <rdfs:label>Closeout requires both financial and reporting conditions</rdfs:label>
    <rdfs:comment>Closeout requires both financial conditions (all Payments made or the award formally reduced) and reporting conditions (all required Reports accepted) to be true.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://github.com/EGovender/commongood-atlas/blob/main/docs/03-relationships.md#key-relationship-rules-draft" />
    <npo:appliesTo rdf:resource="https://egovender.github.io/commongood-atlas/ontology/closeout" />
    <npo:appliesTo rdf:resource="https://egovender.github.io/commongood-atlas/ontology/payment" />
    <npo:appliesTo rdf:resource="https://egovender.github.io/commongood-atlas/ontology/report" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/rules/rule-compliance-requirement-attaches-to-award">
    <rdf:type rdf:resource="https://egovender.github.io/commongood-atlas/ontology/BusinessRule" />
    <rdfs:label>A Compliance Requirement attaches to a specific Award, not the Grantee in the abstract</rdfs:label>
    <rdfs:comment>A Compliance Requirement is always attached to a specific Award, not to the Grantee in the abstract -- the same organization can be in good standing on one award and delinquent on another.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://github.com/EGovender/commongood-atlas/blob/main/docs/03-relationships.md#key-relationship-rules-draft" />
    <npo:appliesTo rdf:resource="https://egovender.github.io/commongood-atlas/ontology/compliance-requirement" />
    <npo:appliesTo rdf:resource="https://egovender.github.io/commongood-atlas/ontology/award" />
    <npo:appliesTo rdf:resource="https://egovender.github.io/commongood-atlas/ontology/grantee" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/rules/rule-grant-recommendation-non-binding">
    <rdf:type rdf:resource="https://egovender.github.io/commongood-atlas/ontology/BusinessRule" />
    <rdfs:label>A Grant Recommendation is non-binding</rdfs:label>
    <rdfs:comment>A Donor Advisor's Grant Recommendation does not itself obligate a Donor-Advised Fund to make an Award; the fund's sponsoring organization retains final legal authority over whether to accept it.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://github.com/EGovender/commongood-atlas/blob/main/docs/08-organizations-roles-and-arrangements.md" />
    <npo:appliesTo rdf:resource="https://egovender.github.io/commongood-atlas/ontology/grant-recommendation" />
    <npo:appliesTo rdf:resource="https://egovender.github.io/commongood-atlas/ontology/donor-advised-fund" />
    <npo:appliesTo rdf:resource="https://egovender.github.io/commongood-atlas/ontology/award" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/rules/rule-installment-condition-before-payment">
    <rdf:type rdf:resource="https://egovender.github.io/commongood-atlas/ontology/BusinessRule" />
    <rdfs:label>An Installment's Payment Condition must be met before release</rdfs:label>
    <rdfs:comment>An Installment's Payment Condition, if any, must be satisfied before its corresponding Payment is released.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://github.com/EGovender/commongood-atlas/blob/main/docs/03-relationships.md#key-relationship-rules-draft" />
    <npo:appliesTo rdf:resource="https://egovender.github.io/commongood-atlas/ontology/installment" />
    <npo:appliesTo rdf:resource="https://egovender.github.io/commongood-atlas/ontology/payment-condition" />
    <npo:appliesTo rdf:resource="https://egovender.github.io/commongood-atlas/ontology/payment" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/rules/rule-payment-requires-award-and-agreement">
    <rdf:type rdf:resource="https://egovender.github.io/commongood-atlas/ontology/BusinessRule" />
    <rdfs:label>A Payment requires an Award, typically with a Grant Agreement</rdfs:label>
    <rdfs:comment>A Payment cannot exist without an Award and, typically, a Grant Agreement -- though some funders disburse an initial installment before a fully signed agreement is in place.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://github.com/EGovender/commongood-atlas/blob/main/docs/03-relationships.md#key-relationship-rules-draft" />
    <npo:appliesTo rdf:resource="https://egovender.github.io/commongood-atlas/ontology/payment" />
    <npo:appliesTo rdf:resource="https://egovender.github.io/commongood-atlas/ontology/award" />
    <npo:appliesTo rdf:resource="https://egovender.github.io/commongood-atlas/ontology/grant-agreement" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/rules/rule-role-effective-to-not-before-from">
    <rdf:type rdf:resource="https://egovender.github.io/commongood-atlas/ontology/BusinessRule" />
    <rdfs:label>A role's effective end date must not precede its start date</rdfs:label>
    <rdfs:comment>A Role occupancy's Effective To, if present, must not be earlier than its Effective From.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://github.com/EGovender/commongood-atlas/blob/main/docs/02-core-concepts.md#organizational-entities" />
    <npo:appliesTo rdf:resource="https://egovender.github.io/commongood-atlas/ontology/role" />
    <npo:appliesTo rdf:resource="https://egovender.github.io/commongood-atlas/ontology/person-role" />
    <npo:appliesTo rdf:resource="https://egovender.github.io/commongood-atlas/ontology/organization-role" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/rules/rule-role-occupancy-requires-context-unless-organization-wide">
    <rdf:type rdf:resource="https://egovender.github.io/commongood-atlas/ontology/BusinessRule" />
    <rdfs:label>A role occupancy should identify its context unless explicitly organization-wide</rdfs:label>
    <rdfs:comment>A Role occupancy should specify what it applies within (via appliesWithin), unless its Scope is explicitly organization-wide -- a role with neither a context nor an organization-wide scope is ambiguous about what it actually governs.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://github.com/EGovender/commongood-atlas/blob/main/docs/02-core-concepts.md#organizational-entities" />
    <npo:appliesTo rdf:resource="https://egovender.github.io/commongood-atlas/ontology/role" />
    <npo:appliesTo rdf:resource="https://egovender.github.io/commongood-atlas/ontology/person-role" />
    <npo:appliesTo rdf:resource="https://egovender.github.io/commongood-atlas/ontology/organization-role" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/rules/rule-role-occupancy-requires-holder">
    <rdf:type rdf:resource="https://egovender.github.io/commongood-atlas/ontology/BusinessRule" />
    <rdfs:label>A role occupancy must identify its role holder</rdfs:label>
    <rdfs:comment>An instance of a Person Role must be held by a Person (via playsRole); an instance of an Organization Role must be held by an Organization (via playsRole). A role occupancy with no holder is not a valid occupancy, only a role definition.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://github.com/EGovender/commongood-atlas/blob/main/docs/02-core-concepts.md#organizational-entities" />
    <npo:appliesTo rdf:resource="https://egovender.github.io/commongood-atlas/ontology/role" />
    <npo:appliesTo rdf:resource="https://egovender.github.io/commongood-atlas/ontology/person-role" />
    <npo:appliesTo rdf:resource="https://egovender.github.io/commongood-atlas/ontology/organization-role" />
    <npo:appliesTo rdf:resource="https://egovender.github.io/commongood-atlas/ontology/person" />
    <npo:appliesTo rdf:resource="https://egovender.github.io/commongood-atlas/ontology/organization" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/reference-data/claim-type">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#ConceptScheme" />
    <skos:prefLabel>Claim Type</skos:prefLabel>
    <skos:definition>How strong an interpretation an Evidence Claim makes about a Project's relationship to a Result -- deliberately distinct, ordered from weakest to strongest evidentiary interpretation, and never treated as equivalent to one another.</skos:definition>
    <npo:schemeDomain>program</npo:schemeDomain>
    <npo:authorityType>internal</npo:authorityType>
    <npo:version>1.0.0</npo:version>
    <npo:publicationStatus rdf:resource="https://egovender.github.io/commongood-atlas/ontology/reference-data/publication-status-published" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/reference-data/claim-type-association">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
    <skos:inScheme rdf:resource="https://egovender.github.io/commongood-atlas/ontology/reference-data/claim-type" />
    <skos:notation>association</skos:notation>
    <skos:prefLabel>Association</skos:prefLabel>
    <skos:definition>Two phenomena are observed together, without asserting that one influenced the other.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/reference-data/claim-type-attribution">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
    <skos:inScheme rdf:resource="https://egovender.github.io/commongood-atlas/ontology/reference-data/claim-type" />
    <skos:notation>attribution</skos:notation>
    <skos:prefLabel>Attribution</skos:prefLabel>
    <skos:definition>The evidence assigns a defined portion or substantial responsibility for the result to the intervention.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/reference-data/claim-type-causation">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
    <skos:inScheme rdf:resource="https://egovender.github.io/commongood-atlas/ontology/reference-data/claim-type" />
    <skos:notation>causation</skos:notation>
    <skos:prefLabel>Causation</skos:prefLabel>
    <skos:definition>The evidence supports a causal relationship between the intervention and the result.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/reference-data/claim-type-contribution">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
    <skos:inScheme rdf:resource="https://egovender.github.io/commongood-atlas/ontology/reference-data/claim-type" />
    <skos:notation>contribution</skos:notation>
    <skos:prefLabel>Contribution</skos:prefLabel>
    <skos:definition>There is evidence that the intervention played some role in producing the result, alongside other factors.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/reference-data/evidence-strength">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#ConceptScheme" />
    <skos:prefLabel>Evidence Strength</skos:prefLabel>
    <skos:definition>How strong the supporting Evidence is for an Evidence Claim, independent of the claim's type (association/contribution/attribution/causation) -- a causation claim and an association claim can each be backed by strong or weak evidence.</skos:definition>
    <npo:schemeDomain>program</npo:schemeDomain>
    <npo:authorityType>internal</npo:authorityType>
    <npo:version>1.0.0</npo:version>
    <npo:publicationStatus rdf:resource="https://egovender.github.io/commongood-atlas/ontology/reference-data/publication-status-published" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/reference-data/evidence-strength-anecdotal">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
    <skos:inScheme rdf:resource="https://egovender.github.io/commongood-atlas/ontology/reference-data/evidence-strength" />
    <skos:notation>anecdotal</skos:notation>
    <skos:prefLabel>Anecdotal</skos:prefLabel>
    <skos:definition>Based on isolated stories or individual accounts, not a systematic review.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/reference-data/evidence-strength-inconclusive">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
    <skos:inScheme rdf:resource="https://egovender.github.io/commongood-atlas/ontology/reference-data/evidence-strength" />
    <skos:notation>inconclusive</skos:notation>
    <skos:prefLabel>Inconclusive</skos:prefLabel>
    <skos:definition>The available evidence does not clearly support or refute the claim.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/reference-data/evidence-strength-limited">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
    <skos:inScheme rdf:resource="https://egovender.github.io/commongood-atlas/ontology/reference-data/evidence-strength" />
    <skos:notation>limited</skos:notation>
    <skos:prefLabel>Limited</skos:prefLabel>
    <skos:definition>Based on a small or narrow body of evidence with significant gaps.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/reference-data/evidence-strength-moderate">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
    <skos:inScheme rdf:resource="https://egovender.github.io/commongood-atlas/ontology/reference-data/evidence-strength" />
    <skos:notation>moderate</skos:notation>
    <skos:prefLabel>Moderate</skos:prefLabel>
    <skos:definition>Based on a reasonably systematic body of evidence with some limitations.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/reference-data/evidence-strength-strong">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
    <skos:inScheme rdf:resource="https://egovender.github.io/commongood-atlas/ontology/reference-data/evidence-strength" />
    <skos:notation>strong</skos:notation>
    <skos:prefLabel>Strong</skos:prefLabel>
    <skos:definition>Based on a rigorous, systematic body of evidence with few limitations.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/reference-data/frequency">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#ConceptScheme" />
    <skos:prefLabel>Frequency</skos:prefLabel>
    <skos:definition>How often a recurring obligation is due. Currently used for how often Reports are due under a Reporting Schedule; generic enough to apply to other recurring obligations later without a new scheme.</skos:definition>
    <npo:schemeDomain>scheduling</npo:schemeDomain>
    <npo:authorityType>internal</npo:authorityType>
    <npo:version>1.0.0</npo:version>
    <npo:publicationStatus rdf:resource="https://egovender.github.io/commongood-atlas/ontology/reference-data/publication-status-published" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/reference-data/frequency-annual">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
    <skos:inScheme rdf:resource="https://egovender.github.io/commongood-atlas/ontology/reference-data/frequency" />
    <skos:notation>annual</skos:notation>
    <skos:prefLabel>Annual</skos:prefLabel>
    <skos:definition>Recurs once a year.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/reference-data/frequency-monthly">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
    <skos:inScheme rdf:resource="https://egovender.github.io/commongood-atlas/ontology/reference-data/frequency" />
    <skos:notation>monthly</skos:notation>
    <skos:prefLabel>Monthly</skos:prefLabel>
    <skos:definition>Recurs every month.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/reference-data/frequency-one-time">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
    <skos:inScheme rdf:resource="https://egovender.github.io/commongood-atlas/ontology/reference-data/frequency" />
    <skos:notation>one-time</skos:notation>
    <skos:prefLabel>One-Time</skos:prefLabel>
    <skos:definition>Occurs once, with no recurrence.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/reference-data/frequency-quarterly">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
    <skos:inScheme rdf:resource="https://egovender.github.io/commongood-atlas/ontology/reference-data/frequency" />
    <skos:notation>quarterly</skos:notation>
    <skos:prefLabel>Quarterly</skos:prefLabel>
    <skos:definition>Recurs every three months.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/reference-data/issue-area">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#ConceptScheme" />
    <skos:prefLabel>Issue Area</skos:prefLabel>
    <skos:definition>The primary social or environmental issue a Project addresses. Not assumed to be a complete list of every possible issue area -- new values can be proposed as real projects need them.</skos:definition>
    <npo:schemeDomain>program</npo:schemeDomain>
    <npo:authorityType>internal</npo:authorityType>
    <npo:version>1.0.0</npo:version>
    <npo:publicationStatus rdf:resource="https://egovender.github.io/commongood-atlas/ontology/reference-data/publication-status-published" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/reference-data/issue-area-arts-and-culture">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
    <skos:inScheme rdf:resource="https://egovender.github.io/commongood-atlas/ontology/reference-data/issue-area" />
    <skos:notation>arts-and-culture</skos:notation>
    <skos:prefLabel>Arts and Culture</skos:prefLabel>
    <skos:definition>Arts, culture, and creative expression.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/reference-data/issue-area-economic-development">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
    <skos:inScheme rdf:resource="https://egovender.github.io/commongood-atlas/ontology/reference-data/issue-area" />
    <skos:notation>economic-development</skos:notation>
    <skos:prefLabel>Economic Development</skos:prefLabel>
    <skos:definition>Employment, income, and local economic opportunity.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/reference-data/issue-area-education">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
    <skos:inScheme rdf:resource="https://egovender.github.io/commongood-atlas/ontology/reference-data/issue-area" />
    <skos:notation>education</skos:notation>
    <skos:prefLabel>Education</skos:prefLabel>
    <skos:definition>Access to and quality of learning, from early childhood through adult education.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/reference-data/issue-area-environment">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
    <skos:inScheme rdf:resource="https://egovender.github.io/commongood-atlas/ontology/reference-data/issue-area" />
    <skos:notation>environment</skos:notation>
    <skos:prefLabel>Environment</skos:prefLabel>
    <skos:definition>Conservation, climate, and natural-resource stewardship.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/reference-data/issue-area-food-security">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
    <skos:inScheme rdf:resource="https://egovender.github.io/commongood-atlas/ontology/reference-data/issue-area" />
    <skos:notation>food-security</skos:notation>
    <skos:prefLabel>Food Security</skos:prefLabel>
    <skos:definition>Reliable access to sufficient, affordable, nutritious food.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/reference-data/issue-area-health">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
    <skos:inScheme rdf:resource="https://egovender.github.io/commongood-atlas/ontology/reference-data/issue-area" />
    <skos:notation>health</skos:notation>
    <skos:prefLabel>Health</skos:prefLabel>
    <skos:definition>Physical and behavioral health, including access to care.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/reference-data/issue-area-housing">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
    <skos:inScheme rdf:resource="https://egovender.github.io/commongood-atlas/ontology/reference-data/issue-area" />
    <skos:notation>housing</skos:notation>
    <skos:prefLabel>Housing</skos:prefLabel>
    <skos:definition>Access to safe, stable, and affordable housing.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/reference-data/issue-area-human-rights">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
    <skos:inScheme rdf:resource="https://egovender.github.io/commongood-atlas/ontology/reference-data/issue-area" />
    <skos:notation>human-rights</skos:notation>
    <skos:prefLabel>Human Rights</skos:prefLabel>
    <skos:definition>Civil rights, civil liberties, and human-rights advocacy.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/reference-data/organization-operating-status">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#ConceptScheme" />
    <skos:prefLabel>Organization Operating Status</skos:prefLabel>
    <skos:definition>Whether an Organization is currently operating, independent of any role it holds or arrangement it participates in.</skos:definition>
    <npo:schemeDomain>organization</npo:schemeDomain>
    <npo:authorityType>internal</npo:authorityType>
    <npo:version>1.0.0</npo:version>
    <npo:publicationStatus rdf:resource="https://egovender.github.io/commongood-atlas/ontology/reference-data/publication-status-published" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/reference-data/organization-operating-status-active">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
    <skos:inScheme rdf:resource="https://egovender.github.io/commongood-atlas/ontology/reference-data/organization-operating-status" />
    <skos:notation>active</skos:notation>
    <skos:prefLabel>Active</skos:prefLabel>
    <skos:definition>The organization is currently operating.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/reference-data/organization-operating-status-dissolved">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
    <skos:inScheme rdf:resource="https://egovender.github.io/commongood-atlas/ontology/reference-data/organization-operating-status" />
    <skos:notation>dissolved</skos:notation>
    <skos:prefLabel>Dissolved</skos:prefLabel>
    <skos:definition>The organization has formally ceased to exist.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/reference-data/organization-operating-status-merged">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
    <skos:inScheme rdf:resource="https://egovender.github.io/commongood-atlas/ontology/reference-data/organization-operating-status" />
    <skos:notation>merged</skos:notation>
    <skos:prefLabel>Merged</skos:prefLabel>
    <skos:definition>The organization has combined into another organization and no longer operates independently.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/reference-data/organization-operating-status-unknown">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
    <skos:inScheme rdf:resource="https://egovender.github.io/commongood-atlas/ontology/reference-data/organization-operating-status" />
    <skos:notation>unknown</skos:notation>
    <skos:prefLabel>Unknown</skos:prefLabel>
    <skos:definition>The organization's current operating status has not been confirmed.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/reference-data/publication-status">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#ConceptScheme" />
    <skos:prefLabel>Publication Status</skos:prefLabel>
    <skos:definition>The lifecycle state of a reference-data scheme itself -- whether it's still being drafted, actively governing one or more properties, or deprecated in favor of something else. Distinct from a single value's own `deprecated` flag: a scheme can stay published while one of its values is retired.</skos:definition>
    <npo:schemeDomain>reference-data-governance</npo:schemeDomain>
    <npo:authorityType>internal</npo:authorityType>
    <npo:version>1.0.0</npo:version>
    <npo:publicationStatus rdf:resource="https://egovender.github.io/commongood-atlas/ontology/reference-data/publication-status-published" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/reference-data/publication-status-deprecated">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
    <skos:inScheme rdf:resource="https://egovender.github.io/commongood-atlas/ontology/reference-data/publication-status" />
    <skos:notation>deprecated</skos:notation>
    <skos:prefLabel>Deprecated</skos:prefLabel>
    <skos:definition>The scheme is no longer recommended for new use, though existing data may still reference its values.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/reference-data/publication-status-draft">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
    <skos:inScheme rdf:resource="https://egovender.github.io/commongood-atlas/ontology/reference-data/publication-status" />
    <skos:notation>draft</skos:notation>
    <skos:prefLabel>Draft</skos:prefLabel>
    <skos:definition>The scheme is still being defined and does not yet constrain any concept property.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/reference-data/publication-status-published">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
    <skos:inScheme rdf:resource="https://egovender.github.io/commongood-atlas/ontology/reference-data/publication-status" />
    <skos:notation>published</skos:notation>
    <skos:prefLabel>Published</skos:prefLabel>
    <skos:definition>The scheme is stable and in active use, constraining one or more concept properties.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/reference-data/restriction-type">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#ConceptScheme" />
    <skos:prefLabel>Restriction Type</skos:prefLabel>
    <skos:definition>A Fund's accounting restriction status -- whether its use is constrained by the donor, and if so, how. `donor-restricted` is the broader designation covering both time-limited and perpetual donor restrictions; `temporarily-restricted` and `permanently-restricted` narrow it to which kind.</skos:definition>
    <npo:schemeDomain>financial</npo:schemeDomain>
    <npo:authorityType>internal</npo:authorityType>
    <npo:version>1.0.0</npo:version>
    <npo:publicationStatus rdf:resource="https://egovender.github.io/commongood-atlas/ontology/reference-data/publication-status-published" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/reference-data/restriction-type-donor-restricted">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
    <skos:inScheme rdf:resource="https://egovender.github.io/commongood-atlas/ontology/reference-data/restriction-type" />
    <skos:notation>donor-restricted</skos:notation>
    <skos:prefLabel>Donor-Restricted</skos:prefLabel>
    <skos:definition>The fund's use is constrained by the donor, without specifying here whether the constraint is time-limited or perpetual.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/reference-data/restriction-type-permanently-restricted">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
    <skos:inScheme rdf:resource="https://egovender.github.io/commongood-atlas/ontology/reference-data/restriction-type" />
    <skos:notation>permanently-restricted</skos:notation>
    <skos:prefLabel>Permanently Restricted</skos:prefLabel>
    <skos:definition>The fund's donor-imposed restriction never expires.</skos:definition>
    <skos:broader rdf:resource="https://egovender.github.io/commongood-atlas/ontology/reference-data/restriction-type-donor-restricted" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/reference-data/restriction-type-temporarily-restricted">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
    <skos:inScheme rdf:resource="https://egovender.github.io/commongood-atlas/ontology/reference-data/restriction-type" />
    <skos:notation>temporarily-restricted</skos:notation>
    <skos:prefLabel>Temporarily Restricted</skos:prefLabel>
    <skos:definition>The fund's donor-imposed restriction expires after a specific time or purpose is satisfied.</skos:definition>
    <skos:broader rdf:resource="https://egovender.github.io/commongood-atlas/ontology/reference-data/restriction-type-donor-restricted" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/reference-data/restriction-type-unrestricted">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
    <skos:inScheme rdf:resource="https://egovender.github.io/commongood-atlas/ontology/reference-data/restriction-type" />
    <skos:notation>unrestricted</skos:notation>
    <skos:prefLabel>Unrestricted</skos:prefLabel>
    <skos:definition>The fund carries no donor-imposed restriction on its use.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/reference-data/role-status">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#ConceptScheme" />
    <skos:prefLabel>Role Status</skos:prefLabel>
    <skos:definition>Where a Role occupancy currently sits in its own lifecycle, shared by every person-role and organization-role subtype via the role concept's inherited `status` property.</skos:definition>
    <npo:schemeDomain>role</npo:schemeDomain>
    <npo:authorityType>internal</npo:authorityType>
    <npo:version>1.0.0</npo:version>
    <npo:publicationStatus rdf:resource="https://egovender.github.io/commongood-atlas/ontology/reference-data/publication-status-published" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/reference-data/role-status-active">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
    <skos:inScheme rdf:resource="https://egovender.github.io/commongood-atlas/ontology/reference-data/role-status" />
    <skos:notation>active</skos:notation>
    <skos:prefLabel>Active</skos:prefLabel>
    <skos:definition>The role occupancy is currently in effect.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/reference-data/role-status-cancelled">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
    <skos:inScheme rdf:resource="https://egovender.github.io/commongood-atlas/ontology/reference-data/role-status" />
    <skos:notation>cancelled</skos:notation>
    <skos:prefLabel>Cancelled</skos:prefLabel>
    <skos:definition>The role occupancy was called off before or without reaching its expected conclusion.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/reference-data/role-status-ended">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
    <skos:inScheme rdf:resource="https://egovender.github.io/commongood-atlas/ontology/reference-data/role-status" />
    <skos:notation>ended</skos:notation>
    <skos:prefLabel>Ended</skos:prefLabel>
    <skos:definition>The role occupancy concluded as expected, e.g. at its effectiveTo date.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/reference-data/role-status-planned">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
    <skos:inScheme rdf:resource="https://egovender.github.io/commongood-atlas/ontology/reference-data/role-status" />
    <skos:notation>planned</skos:notation>
    <skos:prefLabel>Planned</skos:prefLabel>
    <skos:definition>The role occupancy has been agreed but has not yet started.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/reference-data/role-status-suspended">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
    <skos:inScheme rdf:resource="https://egovender.github.io/commongood-atlas/ontology/reference-data/role-status" />
    <skos:notation>suspended</skos:notation>
    <skos:prefLabel>Suspended</skos:prefLabel>
    <skos:definition>The role occupancy is temporarily paused without having formally ended.</skos:definition>
  </rdf:Description>
</rdf:RDF>

    rdfs:domain npo:review ;
    rdfs:isDefinedBy <https://github.com/EGovender/NPOGraph/blob/main/docs/03-relationships.md#the-grant-lifecycle-end-to-end> ;
    rdfs:range npo:review-criteria .

nporel:fiscallySponsoredBy a owl:ObjectProperty ;

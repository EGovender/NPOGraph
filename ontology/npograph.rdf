<?xml version="1.0" encoding="utf-8"?>
<rdf:RDF xmlns:npo="https://egovender.github.io/NPOGraph/ontology/" xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#" xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xmlns:skos="http://www.w3.org/2004/02/skos/core#">
  <rdf:Description rdf:about="https://egovender.github.io/NPOGraph/ontology">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Ontology" />
    <rdfs:label>NPOGraph Grantmaking Ontology</rdfs:label>
    <rdfs:comment>Generated from ontology/source/*.json. Do not hand-edit. See docs/05-data-model.md and docs/06-properties-and-rules.md.</rdfs:comment>
    <npo:version>0.3.0</npo:version>
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/NPOGraph/ontology/amendment">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class" />
    <rdfs:label>Amendment</rdfs:label>
    <skos:definition>A formally agreed change to an existing grant agreement's terms, budget, timeline, or amount, made after the original agreement was signed.</skos:definition>
    <npo:category>award-and-agreement</npo:category>
    <rdfs:isDefinedBy rdf:resource="https://github.com/EGovender/NPOGraph/blob/main/docs/02-core-concepts.md#award-and-agreement" />
    <skos:altLabel>Grant Amendment</skos:altLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/NPOGraph/ontology/applicant-contact">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class" />
    <rdfs:label>Applicant Contact</rdfs:label>
    <skos:definition>The role a person occupies when they serve as the primary point of contact for an application submitted on behalf of an organization or project.</skos:definition>
    <npo:category>organizational-entities</npo:category>
    <rdfs:isDefinedBy rdf:resource="https://github.com/EGovender/NPOGraph/blob/main/docs/02-core-concepts.md#organizational-entities" />
    <rdfs:subClassOf rdf:resource="https://egovender.github.io/NPOGraph/ontology/person-role" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/NPOGraph/ontology/application">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class" />
    <rdfs:label>Application</rdfs:label>
    <skos:definition>A grantee's formal submission requesting funding under a specific funding opportunity, including a proposal narrative and budget.</skos:definition>
    <npo:category>application-and-review</npo:category>
    <rdfs:isDefinedBy rdf:resource="https://github.com/EGovender/NPOGraph/blob/main/docs/02-core-concepts.md#application-and-review" />
    <skos:altLabel>Grant Application</skos:altLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/NPOGraph/ontology/audit">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class" />
    <rdfs:label>Audit</rdfs:label>
    <skos:definition>A formal, independent examination of a grantee's financial records, either as a general organizational requirement or specific to a grant.</skos:definition>
    <npo:category>compliance-and-reporting</npo:category>
    <rdfs:isDefinedBy rdf:resource="https://github.com/EGovender/NPOGraph/blob/main/docs/02-core-concepts.md#compliance-and-reporting" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/NPOGraph/ontology/authorized-signatory">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class" />
    <rdfs:label>Authorized Signatory</rdfs:label>
    <skos:definition>The role a person occupies when they are authorized to sign a grant agreement or other governing document on behalf of an organization.</skos:definition>
    <npo:category>organizational-entities</npo:category>
    <rdfs:isDefinedBy rdf:resource="https://github.com/EGovender/NPOGraph/blob/main/docs/02-core-concepts.md#organizational-entities" />
    <rdfs:subClassOf rdf:resource="https://egovender.github.io/NPOGraph/ontology/person-role" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/NPOGraph/ontology/award">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class" />
    <rdfs:label>Award</rdfs:label>
    <skos:definition>A funder's formal commitment to provide a specific amount of funding to a grantee, following an approved application or decision.</skos:definition>
    <npo:category>award-and-agreement</npo:category>
    <rdfs:isDefinedBy rdf:resource="https://github.com/EGovender/NPOGraph/blob/main/docs/02-core-concepts.md#award-and-agreement" />
    <skos:altLabel>Grant Award</skos:altLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/NPOGraph/ontology/board-member">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class" />
    <rdfs:label>Board Member</rdfs:label>
    <skos:definition>The role a person occupies when they serve on an organization's governing board.</skos:definition>
    <npo:category>organizational-entities</npo:category>
    <rdfs:isDefinedBy rdf:resource="https://github.com/EGovender/NPOGraph/blob/main/docs/02-core-concepts.md#organizational-entities" />
    <rdfs:subClassOf rdf:resource="https://egovender.github.io/NPOGraph/ontology/person-role" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/NPOGraph/ontology/budget">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class" />
    <rdfs:label>Budget</rdfs:label>
    <skos:definition>A structured estimate of costs associated with a proposed or funded project, broken into categories (e.g., personnel, overhead, direct program costs).</skos:definition>
    <npo:category>funding-structure</npo:category>
    <rdfs:isDefinedBy rdf:resource="https://github.com/EGovender/NPOGraph/blob/main/docs/02-core-concepts.md#funding-structure" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/NPOGraph/ontology/budget-modification">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class" />
    <rdfs:label>Budget Modification</rdfs:label>
    <skos:definition>A grantee-requested, funder-approved change to how awarded funds are allocated across budget categories, without changing the total award amount.</skos:definition>
    <npo:category>disbursement</npo:category>
    <rdfs:isDefinedBy rdf:resource="https://github.com/EGovender/NPOGraph/blob/main/docs/02-core-concepts.md#disbursement" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/NPOGraph/ontology/closeout">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class" />
    <rdfs:label>Closeout</rdfs:label>
    <skos:definition>The formal conclusion of a grant award once all funds are disbursed, all reports are submitted and accepted, and all compliance requirements are satisfied.</skos:definition>
    <npo:category>outcomes-and-closeout</npo:category>
    <rdfs:isDefinedBy rdf:resource="https://github.com/EGovender/NPOGraph/blob/main/docs/02-core-concepts.md#outcomes-and-closeout" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/NPOGraph/ontology/collaborative-fund-arrangement">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class" />
    <rdfs:label>Collaborative Fund Arrangement</rdfs:label>
    <skos:definition>A Philanthropic Arrangement in which multiple funders pool resources into a shared Fund and jointly direct or oversee its grantmaking.</skos:definition>
    <npo:category>funding-structure</npo:category>
    <rdfs:isDefinedBy rdf:resource="https://github.com/EGovender/NPOGraph/blob/main/docs/02-core-concepts.md#funding-structure" />
    <rdfs:subClassOf rdf:resource="https://egovender.github.io/NPOGraph/ontology/philanthropic-arrangement" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/NPOGraph/ontology/compliance-requirement">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class" />
    <rdfs:label>Compliance Requirement</rdfs:label>
    <skos:definition>An obligation attached to an award that the grantee must satisfy to remain in good standing (e.g., timely reporting, allowable use of funds, insurance).</skos:definition>
    <npo:category>compliance-and-reporting</npo:category>
    <rdfs:isDefinedBy rdf:resource="https://github.com/EGovender/NPOGraph/blob/main/docs/02-core-concepts.md#compliance-and-reporting" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/NPOGraph/ontology/consultant">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class" />
    <rdfs:label>Consultant</rdfs:label>
    <skos:definition>The role a person occupies when they provide paid, defined-scope services to an organization without being its employee.</skos:definition>
    <npo:category>organizational-entities</npo:category>
    <rdfs:isDefinedBy rdf:resource="https://github.com/EGovender/NPOGraph/blob/main/docs/02-core-concepts.md#organizational-entities" />
    <rdfs:subClassOf rdf:resource="https://egovender.github.io/NPOGraph/ontology/person-role" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/NPOGraph/ontology/contractor">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class" />
    <rdfs:label>Contractor</rdfs:label>
    <skos:definition>The role an organization occupies when it is bound by a contract to deliver a specific, defined piece of work for another organization.</skos:definition>
    <npo:category>organizational-entities</npo:category>
    <rdfs:isDefinedBy rdf:resource="https://github.com/EGovender/NPOGraph/blob/main/docs/02-core-concepts.md#organizational-entities" />
    <rdfs:subClassOf rdf:resource="https://egovender.github.io/NPOGraph/ontology/organization-role" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/NPOGraph/ontology/decision">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class" />
    <rdfs:label>Decision</rdfs:label>
    <skos:definition>The outcome of the review process for an application: approved, declined, or approved with conditions.</skos:definition>
    <npo:category>application-and-review</npo:category>
    <rdfs:isDefinedBy rdf:resource="https://github.com/EGovender/NPOGraph/blob/main/docs/02-core-concepts.md#application-and-review" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/NPOGraph/ontology/donor">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class" />
    <rdfs:label>Donor</rdfs:label>
    <skos:definition>The role a person occupies when they contribute charitable funds to an organization or fund, without necessarily holding advisory privileges over how they are used.</skos:definition>
    <npo:category>organizational-entities</npo:category>
    <rdfs:isDefinedBy rdf:resource="https://github.com/EGovender/NPOGraph/blob/main/docs/02-core-concepts.md#organizational-entities" />
    <rdfs:subClassOf rdf:resource="https://egovender.github.io/NPOGraph/ontology/person-role" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/NPOGraph/ontology/donor-advised-fund">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class" />
    <rdfs:label>Donor-Advised Fund</rdfs:label>
    <skos:definition>A Fund held by a sponsoring organization, over which a Donor Advisor holds non-binding privileges to recommend grants and investments.</skos:definition>
    <npo:category>funding-structure</npo:category>
    <rdfs:isDefinedBy rdf:resource="https://github.com/EGovender/NPOGraph/blob/main/docs/02-core-concepts.md#funding-structure" />
    <skos:altLabel>DAF</skos:altLabel>
    <rdfs:subClassOf rdf:resource="https://egovender.github.io/NPOGraph/ontology/fund" />
    <npo:legalNote>Donor-advised funds are subject to specific federal tax rules (e.g., IRC 4966-4967) governing what a donor advisor may and may not direct. This ontology models the general shape of the relationship, not compliance with those rules.</npo:legalNote>
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/NPOGraph/ontology/donor-advised-fund-arrangement">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class" />
    <rdfs:label>Donor-Advised Fund Arrangement</rdfs:label>
    <skos:definition>A Philanthropic Arrangement in which a Donor Advisor holds non-binding advisory privileges over grants made from a Donor-Advised Fund.</skos:definition>
    <npo:category>funding-structure</npo:category>
    <rdfs:isDefinedBy rdf:resource="https://github.com/EGovender/NPOGraph/blob/main/docs/02-core-concepts.md#funding-structure" />
    <rdfs:subClassOf rdf:resource="https://egovender.github.io/NPOGraph/ontology/philanthropic-arrangement" />
    <npo:legalNote>The specific privileges and limits granted to a donor advisor are set by the sponsoring organization's own policies and by tax law, not by this ontology -- consult counsel before using this model as a compliance reference.</npo:legalNote>
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/NPOGraph/ontology/donor-advisor">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class" />
    <rdfs:label>Donor Advisor</rdfs:label>
    <skos:definition>The role a person occupies when they hold non-binding privileges to recommend grants and investments from a Donor-Advised Fund, typically as the fund's original donor.</skos:definition>
    <npo:category>organizational-entities</npo:category>
    <rdfs:isDefinedBy rdf:resource="https://github.com/EGovender/NPOGraph/blob/main/docs/02-core-concepts.md#organizational-entities" />
    <rdfs:subClassOf rdf:resource="https://egovender.github.io/NPOGraph/ontology/person-role" />
    <npo:legalNote>A donor advisor's privileges are non-binding as a matter of federal tax law, not just convention -- treating a recommendation as a binding instruction can jeopardize the sponsoring organization's tax-exempt status.</npo:legalNote>
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/NPOGraph/ontology/eligibility-criteria">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class" />
    <rdfs:label>Eligibility Criteria</rdfs:label>
    <skos:definition>The conditions an organization or project must meet to apply to a funding opportunity.</skos:definition>
    <npo:category>funding-structure</npo:category>
    <rdfs:isDefinedBy rdf:resource="https://github.com/EGovender/NPOGraph/blob/main/docs/02-core-concepts.md#funding-structure" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/NPOGraph/ontology/employee">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class" />
    <rdfs:label>Employee</rdfs:label>
    <skos:definition>The role a person occupies when they work for and are compensated by an organization.</skos:definition>
    <npo:category>organizational-entities</npo:category>
    <rdfs:isDefinedBy rdf:resource="https://github.com/EGovender/NPOGraph/blob/main/docs/02-core-concepts.md#organizational-entities" />
    <rdfs:subClassOf rdf:resource="https://egovender.github.io/NPOGraph/ontology/person-role" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/NPOGraph/ontology/employer">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class" />
    <rdfs:label>Employer</rdfs:label>
    <skos:definition>The role an organization occupies when it employs a person -- the organization-side counterpart to that person's Employee role.</skos:definition>
    <npo:category>organizational-entities</npo:category>
    <rdfs:isDefinedBy rdf:resource="https://github.com/EGovender/NPOGraph/blob/main/docs/02-core-concepts.md#organizational-entities" />
    <rdfs:subClassOf rdf:resource="https://egovender.github.io/NPOGraph/ontology/organization-role" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/NPOGraph/ontology/evaluation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class" />
    <rdfs:label>Evaluation</rdfs:label>
    <skos:definition>A structured assessment of whether a grant-funded project achieved its intended outputs and outcomes.</skos:definition>
    <npo:category>outcomes-and-closeout</npo:category>
    <rdfs:isDefinedBy rdf:resource="https://github.com/EGovender/NPOGraph/blob/main/docs/02-core-concepts.md#outcomes-and-closeout" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/NPOGraph/ontology/fiscal-sponsor">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class" />
    <rdfs:label>Fiscal Sponsor</rdfs:label>
    <skos:definition>The role an organization occupies when it provides the legal and administrative infrastructure that lets another entity or project receive charitable funding on its behalf.</skos:definition>
    <npo:category>organizational-entities</npo:category>
    <rdfs:isDefinedBy rdf:resource="https://github.com/EGovender/NPOGraph/blob/main/docs/02-core-concepts.md#organizational-entities" />
    <rdfs:subClassOf rdf:resource="https://egovender.github.io/NPOGraph/ontology/organization-role" />
    <npo:legalNote>Fiscal sponsorship arrangements vary significantly in legal structure (e.g., comprehensive/"Model A" vs. pre-approved grant relationship/"Model C"), which affects liability, employment, and asset ownership very differently. Consult counsel before relying on this model to characterize a specific arrangement.</npo:legalNote>
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/NPOGraph/ontology/fiscal-sponsorship-arrangement">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class" />
    <rdfs:label>Fiscal Sponsorship Arrangement</rdfs:label>
    <skos:definition>A Philanthropic Arrangement in which a Fiscal Sponsor accepts and administers charitable funds on behalf of a Sponsored Project that lacks independent legal status to receive them directly.</skos:definition>
    <npo:category>funding-structure</npo:category>
    <rdfs:isDefinedBy rdf:resource="https://github.com/EGovender/NPOGraph/blob/main/docs/02-core-concepts.md#funding-structure" />
    <rdfs:subClassOf rdf:resource="https://egovender.github.io/NPOGraph/ontology/philanthropic-arrangement" />
    <npo:legalNote>The rights and obligations created by a fiscal sponsorship agreement depend heavily on its specific model (e.g., comprehensive vs. pre-approved grant relationship). Consult counsel and the actual governing agreement rather than this ontology.</npo:legalNote>
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/NPOGraph/ontology/fund">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class" />
    <rdfs:label>Fund</rdfs:label>
    <skos:definition>A designated pool of financial resources set aside for a purpose, distinct from the grant program or strategy that directs how it's used.</skos:definition>
    <npo:category>funding-structure</npo:category>
    <rdfs:isDefinedBy rdf:resource="https://github.com/EGovender/NPOGraph/blob/main/docs/02-core-concepts.md#funding-structure" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/NPOGraph/ontology/funder">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class" />
    <rdfs:label>Funder</rdfs:label>
    <skos:definition>The role an organization occupies when it provides funding to grantees through grant programs and awards.</skos:definition>
    <npo:category>organizational-entities</npo:category>
    <rdfs:isDefinedBy rdf:resource="https://github.com/EGovender/NPOGraph/blob/main/docs/02-core-concepts.md#organizational-entities" />
    <skos:altLabel>Grantmaker</skos:altLabel>
    <rdfs:subClassOf rdf:resource="https://egovender.github.io/NPOGraph/ontology/organization-role" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/NPOGraph/ontology/funding-cycle">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class" />
    <rdfs:label>Funding Cycle</rdfs:label>
    <skos:definition>A recurring period (e.g., quarterly, annual) within a grant program during which applications are accepted and decided.</skos:definition>
    <npo:category>funding-structure</npo:category>
    <rdfs:isDefinedBy rdf:resource="https://github.com/EGovender/NPOGraph/blob/main/docs/02-core-concepts.md#funding-structure" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/NPOGraph/ontology/funding-intermediary-role">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class" />
    <rdfs:label>Funding Intermediary Role</rdfs:label>
    <skos:definition>The role an organization occupies when it channels funds between an original funding source and an ultimate grantee, without itself being the original funder or the final recipient.</skos:definition>
    <npo:category>organizational-entities</npo:category>
    <rdfs:isDefinedBy rdf:resource="https://github.com/EGovender/NPOGraph/blob/main/docs/02-core-concepts.md#organizational-entities" />
    <rdfs:subClassOf rdf:resource="https://egovender.github.io/NPOGraph/ontology/organization-role" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/NPOGraph/ontology/funding-opportunity">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class" />
    <rdfs:label>Funding Opportunity</rdfs:label>
    <skos:definition>A specific, time-bound invitation to apply for funding under a grant program, with defined eligibility, focus area, and deadlines.</skos:definition>
    <npo:category>funding-structure</npo:category>
    <rdfs:isDefinedBy rdf:resource="https://github.com/EGovender/NPOGraph/blob/main/docs/02-core-concepts.md#funding-structure" />
    <skos:altLabel>NOFO</skos:altLabel>
    <skos:altLabel>Notice of Funding Opportunity</skos:altLabel>
    <skos:altLabel>RFP</skos:altLabel>
    <skos:altLabel>Request for Proposals</skos:altLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/NPOGraph/ontology/grant-administrator">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class" />
    <rdfs:label>Grant Administrator</rdfs:label>
    <skos:definition>The role a person occupies when they are responsible for compliance, reporting, and financial management of an award on behalf of the grantee organization.</skos:definition>
    <npo:category>organizational-entities</npo:category>
    <rdfs:isDefinedBy rdf:resource="https://github.com/EGovender/NPOGraph/blob/main/docs/02-core-concepts.md#organizational-entities" />
    <rdfs:subClassOf rdf:resource="https://egovender.github.io/NPOGraph/ontology/person-role" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/NPOGraph/ontology/grant-agreement">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class" />
    <rdfs:label>Grant Agreement</rdfs:label>
    <skos:definition>The legal document, signed by both funder and grantee, that formalizes an award's terms, conditions, and obligations.</skos:definition>
    <npo:category>award-and-agreement</npo:category>
    <rdfs:isDefinedBy rdf:resource="https://github.com/EGovender/NPOGraph/blob/main/docs/02-core-concepts.md#award-and-agreement" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/NPOGraph/ontology/grant-lifecycle">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class" />
    <rdfs:label>Grant Lifecycle</rdfs:label>
    <skos:definition>The end-to-end sequence a grant moves through, from funding opportunity through application, review, award, disbursement, reporting, and closeout.</skos:definition>
    <npo:category>cross-cutting</npo:category>
    <rdfs:isDefinedBy rdf:resource="https://github.com/EGovender/NPOGraph/blob/main/docs/02-core-concepts.md#cross-cutting" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/NPOGraph/ontology/grant-program">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class" />
    <rdfs:label>Grant Program</rdfs:label>
    <skos:definition>A funder's standing area of giving (e.g., "Environmental Justice Grants"), under which funding opportunities are issued over time.</skos:definition>
    <npo:category>funding-structure</npo:category>
    <rdfs:isDefinedBy rdf:resource="https://github.com/EGovender/NPOGraph/blob/main/docs/02-core-concepts.md#funding-structure" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/NPOGraph/ontology/grant-recommendation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class" />
    <rdfs:label>Grant Recommendation</rdfs:label>
    <skos:definition>A Donor Advisor's non-binding request that a Donor-Advised Fund make an award to a specific recipient; the fund's sponsoring organization retains final authority to accept or decline it.</skos:definition>
    <npo:category>application-and-review</npo:category>
    <rdfs:isDefinedBy rdf:resource="https://github.com/EGovender/NPOGraph/blob/main/docs/02-core-concepts.md#application-and-review" />
    <npo:legalNote>A Grant Recommendation's non-binding status is a legal requirement for donor-advised funds under federal tax law, not a design choice -- see Donor-Advised Fund and Donor Advisor.</npo:legalNote>
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/NPOGraph/ontology/grantee">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class" />
    <rdfs:label>Grantee</rdfs:label>
    <skos:definition>The role an organization occupies when it receives and administers grant funding awarded by a funder.</skos:definition>
    <npo:category>organizational-entities</npo:category>
    <rdfs:isDefinedBy rdf:resource="https://github.com/EGovender/NPOGraph/blob/main/docs/02-core-concepts.md#organizational-entities" />
    <skos:altLabel>Recipient</skos:altLabel>
    <skos:altLabel>Subrecipient</skos:altLabel>
    <rdfs:subClassOf rdf:resource="https://egovender.github.io/NPOGraph/ontology/organization-role" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/NPOGraph/ontology/indirect-cost-rate">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class" />
    <rdfs:label>Indirect Cost Rate</rdfs:label>
    <skos:definition>The negotiated or de minimis rate at which a grantee may charge overhead/administrative costs against an award.</skos:definition>
    <npo:category>compliance-and-reporting</npo:category>
    <rdfs:isDefinedBy rdf:resource="https://github.com/EGovender/NPOGraph/blob/main/docs/02-core-concepts.md#compliance-and-reporting" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/NPOGraph/ontology/installment">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class" />
    <rdfs:label>Installment</rdfs:label>
    <skos:definition>A single scheduled portion of an award's total funds, to be disbursed at a defined point or upon meeting a condition.</skos:definition>
    <npo:category>disbursement</npo:category>
    <rdfs:isDefinedBy rdf:resource="https://github.com/EGovender/NPOGraph/blob/main/docs/02-core-concepts.md#disbursement" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/NPOGraph/ontology/letter-of-inquiry">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class" />
    <rdfs:label>Letter of Inquiry</rdfs:label>
    <skos:definition>A brief, preliminary submission used by some funders to screen interest before inviting a full application.</skos:definition>
    <npo:category>application-and-review</npo:category>
    <rdfs:isDefinedBy rdf:resource="https://github.com/EGovender/NPOGraph/blob/main/docs/02-core-concepts.md#application-and-review" />
    <skos:altLabel>LOI</skos:altLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/NPOGraph/ontology/logic-model">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class" />
    <rdfs:label>Logic Model</rdfs:label>
    <skos:definition>A structured diagram connecting a project's inputs, activities, outputs, and outcomes, used to plan and evaluate a grant-funded project.</skos:definition>
    <npo:category>outcomes-and-closeout</npo:category>
    <rdfs:isDefinedBy rdf:resource="https://github.com/EGovender/NPOGraph/blob/main/docs/02-core-concepts.md#outcomes-and-closeout" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/NPOGraph/ontology/matching-requirement">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class" />
    <rdfs:label>Matching Requirement</rdfs:label>
    <skos:definition>A condition requiring the grantee to raise or contribute additional funds alongside the award, often as a ratio (e.g., 1:1 match).</skos:definition>
    <npo:category>award-and-agreement</npo:category>
    <rdfs:isDefinedBy rdf:resource="https://github.com/EGovender/NPOGraph/blob/main/docs/02-core-concepts.md#award-and-agreement" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/NPOGraph/ontology/organization">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class" />
    <rdfs:label>Organization</rdfs:label>
    <skos:definition>Any legal entity participating in grantmaking or philanthropy. An organization occupies one or more contextual roles (see Organization Role) rather than being permanently classified as a funder or a recipient.</skos:definition>
    <npo:category>organizational-entities</npo:category>
    <rdfs:isDefinedBy rdf:resource="https://github.com/EGovender/NPOGraph/blob/main/docs/02-core-concepts.md#organizational-entities" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/NPOGraph/ontology/organization-role">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class" />
    <rdfs:label>Organization Role</rdfs:label>
    <skos:definition>A contextual capacity an organization occupies within a specific arrangement or award -- such as acting as a funder, grant recipient, or fiscal sponsor -- rather than a permanent trait of the organization itself.</skos:definition>
    <npo:category>organizational-entities</npo:category>
    <rdfs:isDefinedBy rdf:resource="https://github.com/EGovender/NPOGraph/blob/main/docs/02-core-concepts.md#organizational-entities" />
    <rdfs:subClassOf rdf:resource="https://egovender.github.io/NPOGraph/ontology/role" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/NPOGraph/ontology/organization-type">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class" />
    <rdfs:label>Organization Type</rdfs:label>
    <skos:definition>The legal and tax classification of what an organization fundamentally is (e.g., a public charity, private foundation, or government entity), independent of any role it plays in a specific relationship.</skos:definition>
    <npo:category>organizational-entities</npo:category>
    <rdfs:isDefinedBy rdf:resource="https://github.com/EGovender/NPOGraph/blob/main/docs/02-core-concepts.md#organizational-entities" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/NPOGraph/ontology/outcome">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class" />
    <rdfs:label>Outcome</rdfs:label>
    <skos:definition>A change in condition, behavior, knowledge, or status that results from grant-funded activity, distinct from an output.</skos:definition>
    <npo:category>outcomes-and-closeout</npo:category>
    <rdfs:isDefinedBy rdf:resource="https://github.com/EGovender/NPOGraph/blob/main/docs/02-core-concepts.md#outcomes-and-closeout" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/NPOGraph/ontology/output">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class" />
    <rdfs:label>Output</rdfs:label>
    <skos:definition>A direct, countable product of grant-funded activity (e.g., number of workshops held, people served).</skos:definition>
    <npo:category>outcomes-and-closeout</npo:category>
    <rdfs:isDefinedBy rdf:resource="https://github.com/EGovender/NPOGraph/blob/main/docs/02-core-concepts.md#outcomes-and-closeout" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/NPOGraph/ontology/partner">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class" />
    <rdfs:label>Partner</rdfs:label>
    <skos:definition>The role an organization occupies when it collaborates with another organization on shared work, in a relationship not adequately described as one party purchasing from or providing a service to the other.</skos:definition>
    <npo:category>organizational-entities</npo:category>
    <rdfs:isDefinedBy rdf:resource="https://github.com/EGovender/NPOGraph/blob/main/docs/02-core-concepts.md#organizational-entities" />
    <rdfs:subClassOf rdf:resource="https://egovender.github.io/NPOGraph/ontology/organization-role" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/NPOGraph/ontology/payment">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class" />
    <rdfs:label>Payment</rdfs:label>
    <skos:definition>An actual transfer of funds from funder to grantee against an award, corresponding to one or more installments.</skos:definition>
    <npo:category>disbursement</npo:category>
    <rdfs:isDefinedBy rdf:resource="https://github.com/EGovender/NPOGraph/blob/main/docs/02-core-concepts.md#disbursement" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/NPOGraph/ontology/payment-condition">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class" />
    <rdfs:label>Payment Condition</rdfs:label>
    <skos:definition>A requirement (e.g., a submitted report, a milestone reached) that must be satisfied before a scheduled payment is released.</skos:definition>
    <npo:category>disbursement</npo:category>
    <rdfs:isDefinedBy rdf:resource="https://github.com/EGovender/NPOGraph/blob/main/docs/02-core-concepts.md#disbursement" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/NPOGraph/ontology/payment-schedule">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class" />
    <rdfs:label>Payment Schedule</rdfs:label>
    <skos:definition>The agreed timing and amounts by which award funds will be disbursed to the grantee.</skos:definition>
    <npo:category>disbursement</npo:category>
    <rdfs:isDefinedBy rdf:resource="https://github.com/EGovender/NPOGraph/blob/main/docs/02-core-concepts.md#disbursement" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/NPOGraph/ontology/person">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class" />
    <rdfs:label>Person</rdfs:label>
    <skos:definition>A natural person who participates in nonprofit, philanthropic, governance, employment, advisory, or service relationships.</skos:definition>
    <npo:category>organizational-entities</npo:category>
    <rdfs:isDefinedBy rdf:resource="https://github.com/EGovender/NPOGraph/blob/main/docs/02-core-concepts.md#organizational-entities" />
    <skos:altLabel>Individual</skos:altLabel>
    <skos:altLabel>Natural Person</skos:altLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/NPOGraph/ontology/person-role">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class" />
    <rdfs:label>Person Role</rdfs:label>
    <skos:definition>A contextual capacity a person occupies within an organization, award, application, agreement, arrangement, program, project, or other defined context.</skos:definition>
    <npo:category>organizational-entities</npo:category>
    <rdfs:isDefinedBy rdf:resource="https://github.com/EGovender/NPOGraph/blob/main/docs/02-core-concepts.md#organizational-entities" />
    <rdfs:subClassOf rdf:resource="https://egovender.github.io/NPOGraph/ontology/role" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/NPOGraph/ontology/philanthropic-arrangement">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class" />
    <rdfs:label>Philanthropic Arrangement</rdfs:label>
    <skos:definition>A structured relationship among organizations that channels philanthropic funding outside a direct funder-to-grantee award -- such as a fiscal sponsorship or donor-advised fund arrangement.</skos:definition>
    <npo:category>funding-structure</npo:category>
    <rdfs:isDefinedBy rdf:resource="https://github.com/EGovender/NPOGraph/blob/main/docs/02-core-concepts.md#funding-structure" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/NPOGraph/ontology/philanthropic-intermediary">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class" />
    <rdfs:label>Philanthropic Intermediary</rdfs:label>
    <skos:definition>An organization commonly known for facilitating philanthropy on behalf of others -- such as by re-granting, fiscal sponsorship, or hosting donor-advised funds -- regardless of which specific role it occupies in a given arrangement.</skos:definition>
    <npo:category>organizational-entities</npo:category>
    <rdfs:isDefinedBy rdf:resource="https://github.com/EGovender/NPOGraph/blob/main/docs/02-core-concepts.md#organizational-entities" />
    <rdfs:subClassOf rdf:resource="https://egovender.github.io/NPOGraph/ontology/organization" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/NPOGraph/ontology/program-officer">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class" />
    <rdfs:label>Program Officer</rdfs:label>
    <skos:definition>The role a person occupies when they manage a portfolio of grants on behalf of a funder, from soliciting or reviewing applications through monitoring active awards.</skos:definition>
    <npo:category>organizational-entities</npo:category>
    <rdfs:isDefinedBy rdf:resource="https://github.com/EGovender/NPOGraph/blob/main/docs/02-core-concepts.md#organizational-entities" />
    <rdfs:subClassOf rdf:resource="https://egovender.github.io/NPOGraph/ontology/person-role" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/NPOGraph/ontology/regranting-arrangement">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class" />
    <rdfs:label>Regranting Arrangement</rdfs:label>
    <skos:definition>A Philanthropic Arrangement in which an organization receives funds and redistributes them to other organizations, acting as both a Grantee to the original source and a Funder or Funding Intermediary to the recipients.</skos:definition>
    <npo:category>funding-structure</npo:category>
    <rdfs:isDefinedBy rdf:resource="https://github.com/EGovender/NPOGraph/blob/main/docs/02-core-concepts.md#funding-structure" />
    <rdfs:subClassOf rdf:resource="https://egovender.github.io/NPOGraph/ontology/philanthropic-arrangement" />
    <npo:legalNote>Regranting to organizations without their own tax-exempt status (or across borders) can trigger expenditure-responsibility or equivalency-determination requirements under U.S. tax law. This ontology does not model those compliance steps.</npo:legalNote>
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/NPOGraph/ontology/report">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class" />
    <rdfs:label>Report</rdfs:label>
    <skos:definition>A grantee's submission to the funder describing progress, outcomes, and/or use of funds, per the reporting schedule. Narrative and financial reports are common subtypes.</skos:definition>
    <npo:category>compliance-and-reporting</npo:category>
    <rdfs:isDefinedBy rdf:resource="https://github.com/EGovender/NPOGraph/blob/main/docs/02-core-concepts.md#compliance-and-reporting" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/NPOGraph/ontology/reporting-schedule">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class" />
    <rdfs:label>Reporting Schedule</rdfs:label>
    <skos:definition>The agreed cadence and due dates for narrative and financial reports over the life of an award.</skos:definition>
    <npo:category>compliance-and-reporting</npo:category>
    <rdfs:isDefinedBy rdf:resource="https://github.com/EGovender/NPOGraph/blob/main/docs/02-core-concepts.md#compliance-and-reporting" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/NPOGraph/ontology/restricted-funding">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class" />
    <rdfs:label>Restricted Funding</rdfs:label>
    <skos:definition>Funding that must be used for a specific purpose, project, or time period defined in the grant agreement.</skos:definition>
    <npo:category>award-and-agreement</npo:category>
    <rdfs:isDefinedBy rdf:resource="https://github.com/EGovender/NPOGraph/blob/main/docs/02-core-concepts.md#award-and-agreement" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/NPOGraph/ontology/review">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class" />
    <rdfs:label>Review</rdfs:label>
    <skos:definition>The process of evaluating an application, producing a recommendation and often a score, conducted by one or more reviewers.</skos:definition>
    <npo:category>application-and-review</npo:category>
    <rdfs:isDefinedBy rdf:resource="https://github.com/EGovender/NPOGraph/blob/main/docs/02-core-concepts.md#application-and-review" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/NPOGraph/ontology/review-criteria">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class" />
    <rdfs:label>Review Criteria</rdfs:label>
    <skos:definition>The published or internal standards (e.g., alignment with mission, feasibility, budget reasonableness) against which applications are scored.</skos:definition>
    <npo:category>application-and-review</npo:category>
    <rdfs:isDefinedBy rdf:resource="https://github.com/EGovender/NPOGraph/blob/main/docs/02-core-concepts.md#application-and-review" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/NPOGraph/ontology/reviewer">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class" />
    <rdfs:label>Reviewer</rdfs:label>
    <skos:definition>The role a person occupies when they evaluate an application against review criteria, whether as staff, a board member, or an external peer reviewer.</skos:definition>
    <npo:category>organizational-entities</npo:category>
    <rdfs:isDefinedBy rdf:resource="https://github.com/EGovender/NPOGraph/blob/main/docs/02-core-concepts.md#organizational-entities" />
    <rdfs:subClassOf rdf:resource="https://egovender.github.io/NPOGraph/ontology/person-role" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/NPOGraph/ontology/role">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class" />
    <rdfs:label>Role</rdfs:label>
    <skos:definition>A contextual capacity an agent occupies, distinct from the agent's permanent identity or classification.</skos:definition>
    <npo:category>organizational-entities</npo:category>
    <rdfs:isDefinedBy rdf:resource="https://github.com/EGovender/NPOGraph/blob/main/docs/02-core-concepts.md#organizational-entities" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/NPOGraph/ontology/service-provider">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class" />
    <rdfs:label>Service Provider</rdfs:label>
    <skos:definition>The role an organization occupies when it provides an ongoing operational service to another organization -- broader and less transactional than a single Contractor engagement or Vendor purchase.</skos:definition>
    <npo:category>organizational-entities</npo:category>
    <rdfs:isDefinedBy rdf:resource="https://github.com/EGovender/NPOGraph/blob/main/docs/02-core-concepts.md#organizational-entities" />
    <rdfs:subClassOf rdf:resource="https://egovender.github.io/NPOGraph/ontology/organization-role" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/NPOGraph/ontology/site-visit">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class" />
    <rdfs:label>Site Visit</rdfs:label>
    <skos:definition>An optional step where a funder representative visits or meets with an applicant to assess capacity or verify claims before a decision.</skos:definition>
    <npo:category>application-and-review</npo:category>
    <rdfs:isDefinedBy rdf:resource="https://github.com/EGovender/NPOGraph/blob/main/docs/02-core-concepts.md#application-and-review" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/NPOGraph/ontology/sponsored-project">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class" />
    <rdfs:label>Sponsored Project</rdfs:label>
    <skos:definition>A project or group carrying out charitable activity under a Fiscal Sponsor's legal and administrative umbrella, without being itself an independent Organization.</skos:definition>
    <npo:category>organizational-entities</npo:category>
    <rdfs:isDefinedBy rdf:resource="https://github.com/EGovender/NPOGraph/blob/main/docs/02-core-concepts.md#organizational-entities" />
    <npo:legalNote>Whether a sponsored project's activities, staff, and liabilities legally belong to the fiscal sponsor depends entirely on the specific fiscal sponsorship model in use. This ontology does not distinguish between models -- consult the governing agreement.</npo:legalNote>
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/NPOGraph/ontology/sponsoring-organization">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class" />
    <rdfs:label>Sponsoring Organization</rdfs:label>
    <skos:definition>The role an organization occupies when it holds and administers a Fund on behalf of the fund's donor or benefactors, distinct from acting as a Fiscal Sponsor for a specific project.</skos:definition>
    <npo:category>organizational-entities</npo:category>
    <rdfs:isDefinedBy rdf:resource="https://github.com/EGovender/NPOGraph/blob/main/docs/02-core-concepts.md#organizational-entities" />
    <rdfs:subClassOf rdf:resource="https://egovender.github.io/NPOGraph/ontology/organization-role" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/NPOGraph/ontology/terms-and-conditions">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class" />
    <rdfs:label>Terms and Conditions</rdfs:label>
    <skos:definition>The specific obligations, restrictions, and expectations attached to an award (e.g., allowable uses of funds, reporting requirements).</skos:definition>
    <npo:category>award-and-agreement</npo:category>
    <rdfs:isDefinedBy rdf:resource="https://github.com/EGovender/NPOGraph/blob/main/docs/02-core-concepts.md#award-and-agreement" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/NPOGraph/ontology/theory-of-change">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class" />
    <rdfs:label>Theory of Change</rdfs:label>
    <skos:definition>A grantee's or funder's articulated model of how specific activities are expected to lead to desired long-term change.</skos:definition>
    <npo:category>outcomes-and-closeout</npo:category>
    <rdfs:isDefinedBy rdf:resource="https://github.com/EGovender/NPOGraph/blob/main/docs/02-core-concepts.md#outcomes-and-closeout" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/NPOGraph/ontology/unrestricted-funding">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class" />
    <rdfs:label>Unrestricted Funding</rdfs:label>
    <skos:definition>Funding a grantee may use at its discretion in support of its general mission.</skos:definition>
    <npo:category>award-and-agreement</npo:category>
    <rdfs:isDefinedBy rdf:resource="https://github.com/EGovender/NPOGraph/blob/main/docs/02-core-concepts.md#award-and-agreement" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/NPOGraph/ontology/vendor">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class" />
    <rdfs:label>Vendor</rdfs:label>
    <skos:definition>The role an organization occupies when it is the source from which another organization purchases standard goods or services, without a defined-work contract the way a Contractor has.</skos:definition>
    <npo:category>organizational-entities</npo:category>
    <rdfs:isDefinedBy rdf:resource="https://github.com/EGovender/NPOGraph/blob/main/docs/02-core-concepts.md#organizational-entities" />
    <rdfs:subClassOf rdf:resource="https://egovender.github.io/NPOGraph/ontology/organization-role" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/NPOGraph/ontology/relations/modifiesGrantAgreement">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty" />
    <rdfs:label>modifies</rdfs:label>
    <rdfs:comment>An Amendment changes the Grant Agreement going forward; it does not retroactively alter Payments or Reports already completed under the prior terms.</rdfs:comment>
    <rdfs:domain rdf:resource="https://egovender.github.io/NPOGraph/ontology/amendment" />
    <rdfs:range rdf:resource="https://egovender.github.io/NPOGraph/ontology/grant-agreement" />
    <rdfs:isDefinedBy rdf:resource="https://github.com/EGovender/NPOGraph/blob/main/docs/03-relationships.md#key-relationship-rules-draft" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/NPOGraph/ontology/relations/includesBudget">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty" />
    <rdfs:label>includes</rdfs:label>
    <rdfs:comment>An Application includes a proposed Budget.</rdfs:comment>
    <rdfs:domain rdf:resource="https://egovender.github.io/NPOGraph/ontology/application" />
    <rdfs:range rdf:resource="https://egovender.github.io/NPOGraph/ontology/budget" />
    <rdfs:isDefinedBy rdf:resource="https://github.com/EGovender/NPOGraph/blob/main/docs/03-relationships.md#the-grant-lifecycle-end-to-end" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/NPOGraph/ontology/relations/respondsToFundingOpportunity">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty" />
    <rdfs:label>responds to</rdfs:label>
    <rdfs:comment>An Application is submitted in response to a specific Funding Opportunity.</rdfs:comment>
    <rdfs:domain rdf:resource="https://egovender.github.io/NPOGraph/ontology/application" />
    <rdfs:range rdf:resource="https://egovender.github.io/NPOGraph/ontology/funding-opportunity" />
    <rdfs:isDefinedBy rdf:resource="https://github.com/EGovender/NPOGraph/blob/main/docs/03-relationships.md#the-grant-lifecycle-end-to-end" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/NPOGraph/ontology/relations/undergoesReview">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty" />
    <rdfs:label>undergoes</rdfs:label>
    <rdfs:comment>An Application undergoes Review by one or more Reviewers.</rdfs:comment>
    <rdfs:domain rdf:resource="https://egovender.github.io/NPOGraph/ontology/application" />
    <rdfs:range rdf:resource="https://egovender.github.io/NPOGraph/ontology/review" />
    <rdfs:isDefinedBy rdf:resource="https://github.com/EGovender/NPOGraph/blob/main/docs/03-relationships.md#the-grant-lifecycle-end-to-end" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/NPOGraph/ontology/relations/awardedBy">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty" />
    <rdfs:label>is awarded by</rdfs:label>
    <rdfs:comment>An Award is awarded by an Organization -- the original source of the funding, which may differ from the organization that administers it.</rdfs:comment>
    <rdfs:domain rdf:resource="https://egovender.github.io/NPOGraph/ontology/award" />
    <rdfs:range rdf:resource="https://egovender.github.io/NPOGraph/ontology/organization" />
    <rdfs:isDefinedBy rdf:resource="https://github.com/EGovender/NPOGraph/blob/main/docs/08-organizations-roles-and-arrangements.md" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/NPOGraph/ontology/relations/awardedTo">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty" />
    <rdfs:label>is awarded to</rdfs:label>
    <rdfs:comment>An Award is awarded to an Organization -- the ultimate recipient, which may differ from the organization managing compliance on its behalf.</rdfs:comment>
    <rdfs:domain rdf:resource="https://egovender.github.io/NPOGraph/ontology/award" />
    <rdfs:range rdf:resource="https://egovender.github.io/NPOGraph/ontology/organization" />
    <rdfs:isDefinedBy rdf:resource="https://github.com/EGovender/NPOGraph/blob/main/docs/08-organizations-roles-and-arrangements.md" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/NPOGraph/ontology/relations/followsGrantLifecycle">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty" />
    <rdfs:label>follows</rdfs:label>
    <rdfs:comment>An Award's progression from decision through closeout follows the Grant Lifecycle sequence.</rdfs:comment>
    <rdfs:domain rdf:resource="https://egovender.github.io/NPOGraph/ontology/award" />
    <rdfs:range rdf:resource="https://egovender.github.io/NPOGraph/ontology/grant-lifecycle" />
    <rdfs:isDefinedBy rdf:resource="https://github.com/EGovender/NPOGraph/blob/main/docs/03-relationships.md#the-grant-lifecycle-end-to-end" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/NPOGraph/ontology/relations/formalizedByGrantAgreement">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty" />
    <rdfs:label>is formalized by</rdfs:label>
    <rdfs:comment>An Award is formalized by a Grant Agreement.</rdfs:comment>
    <rdfs:domain rdf:resource="https://egovender.github.io/NPOGraph/ontology/award" />
    <rdfs:range rdf:resource="https://egovender.github.io/NPOGraph/ontology/grant-agreement" />
    <rdfs:isDefinedBy rdf:resource="https://github.com/EGovender/NPOGraph/blob/main/docs/03-relationships.md#the-grant-lifecycle-end-to-end" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/NPOGraph/ontology/relations/fundedFrom">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty" />
    <rdfs:label>is funded from</rdfs:label>
    <rdfs:comment>An Award draws its funds from a specific Fund.</rdfs:comment>
    <rdfs:domain rdf:resource="https://egovender.github.io/NPOGraph/ontology/award" />
    <rdfs:range rdf:resource="https://egovender.github.io/NPOGraph/ontology/fund" />
    <rdfs:isDefinedBy rdf:resource="https://github.com/EGovender/NPOGraph/blob/main/docs/08-organizations-roles-and-arrangements.md" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/NPOGraph/ontology/relations/hasPaymentSchedule">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty" />
    <rdfs:label>has</rdfs:label>
    <rdfs:comment>An Award's funds are released according to a Payment Schedule.</rdfs:comment>
    <rdfs:domain rdf:resource="https://egovender.github.io/NPOGraph/ontology/award" />
    <rdfs:range rdf:resource="https://egovender.github.io/NPOGraph/ontology/payment-schedule" />
    <rdfs:isDefinedBy rdf:resource="https://github.com/EGovender/NPOGraph/blob/main/docs/03-relationships.md#the-grant-lifecycle-end-to-end" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/NPOGraph/ontology/relations/managedBy">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty" />
    <rdfs:label>is administered by</rdfs:label>
    <rdfs:comment>An Award may be administered day-to-day by an Organization other than the one that awarded or received it, such as a fiscal sponsor or intermediary.</rdfs:comment>
    <rdfs:domain rdf:resource="https://egovender.github.io/NPOGraph/ontology/award" />
    <rdfs:range rdf:resource="https://egovender.github.io/NPOGraph/ontology/organization" />
    <rdfs:isDefinedBy rdf:resource="https://github.com/EGovender/NPOGraph/blob/main/docs/08-organizations-roles-and-arrangements.md" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/NPOGraph/ontology/relations/reachesCloseout">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty" />
    <rdfs:label>reaches</rdfs:label>
    <rdfs:comment>Once all Payments are disbursed and all Compliance Requirements are satisfied, the Award reaches Closeout.</rdfs:comment>
    <rdfs:domain rdf:resource="https://egovender.github.io/NPOGraph/ontology/award" />
    <rdfs:range rdf:resource="https://egovender.github.io/NPOGraph/ontology/closeout" />
    <rdfs:isDefinedBy rdf:resource="https://github.com/EGovender/NPOGraph/blob/main/docs/03-relationships.md#the-grant-lifecycle-end-to-end" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/NPOGraph/ontology/relations/pools">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty" />
    <rdfs:label>pools</rdfs:label>
    <rdfs:comment>A Collaborative Fund Arrangement pools multiple funders' contributions into a shared Fund.</rdfs:comment>
    <rdfs:domain rdf:resource="https://egovender.github.io/NPOGraph/ontology/collaborative-fund-arrangement" />
    <rdfs:range rdf:resource="https://egovender.github.io/NPOGraph/ontology/fund" />
    <rdfs:isDefinedBy rdf:resource="https://github.com/EGovender/NPOGraph/blob/main/docs/08-organizations-roles-and-arrangements.md" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/NPOGraph/ontology/relations/includesReportingSchedule">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty" />
    <rdfs:label>includes</rdfs:label>
    <rdfs:comment>A Compliance Requirement includes a Reporting Schedule that obligates the Grantee to submit Reports.</rdfs:comment>
    <rdfs:domain rdf:resource="https://egovender.github.io/NPOGraph/ontology/compliance-requirement" />
    <rdfs:range rdf:resource="https://egovender.github.io/NPOGraph/ontology/reporting-schedule" />
    <rdfs:isDefinedBy rdf:resource="https://github.com/EGovender/NPOGraph/blob/main/docs/03-relationships.md#the-grant-lifecycle-end-to-end" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/NPOGraph/ontology/relations/mayIncludeAudit">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty" />
    <rdfs:label>may include</rdfs:label>
    <rdfs:comment>A Compliance Requirement may include an Audit.</rdfs:comment>
    <rdfs:domain rdf:resource="https://egovender.github.io/NPOGraph/ontology/compliance-requirement" />
    <rdfs:range rdf:resource="https://egovender.github.io/NPOGraph/ontology/audit" />
    <rdfs:isDefinedBy rdf:resource="https://github.com/EGovender/NPOGraph/blob/main/docs/03-relationships.md#the-grant-lifecycle-end-to-end" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/NPOGraph/ontology/relations/resultsInAward">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty" />
    <rdfs:label>results in</rdfs:label>
    <rdfs:comment>An approved Decision results in an Award.</rdfs:comment>
    <rdfs:domain rdf:resource="https://egovender.github.io/NPOGraph/ontology/decision" />
    <rdfs:range rdf:resource="https://egovender.github.io/NPOGraph/ontology/award" />
    <rdfs:isDefinedBy rdf:resource="https://github.com/EGovender/NPOGraph/blob/main/docs/03-relationships.md#the-grant-lifecycle-end-to-end" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/NPOGraph/ontology/relations/governs">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty" />
    <rdfs:label>governs</rdfs:label>
    <rdfs:comment>A Donor-Advised Fund Arrangement governs the specific Donor-Advised Fund it establishes the advisory relationship for.</rdfs:comment>
    <rdfs:domain rdf:resource="https://egovender.github.io/NPOGraph/ontology/donor-advised-fund-arrangement" />
    <rdfs:range rdf:resource="https://egovender.github.io/NPOGraph/ontology/donor-advised-fund" />
    <rdfs:isDefinedBy rdf:resource="https://github.com/EGovender/NPOGraph/blob/main/docs/08-organizations-roles-and-arrangements.md" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/NPOGraph/ontology/relations/advises">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty" />
    <rdfs:label>advises</rdfs:label>
    <rdfs:comment>A Donor Advisor advises a specific Donor-Advised Fund, holding non-binding privileges to recommend its grants and investments.</rdfs:comment>
    <rdfs:domain rdf:resource="https://egovender.github.io/NPOGraph/ontology/donor-advisor" />
    <rdfs:range rdf:resource="https://egovender.github.io/NPOGraph/ontology/donor-advised-fund" />
    <rdfs:isDefinedBy rdf:resource="https://github.com/EGovender/NPOGraph/blob/main/docs/08-organizations-roles-and-arrangements.md" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/NPOGraph/ontology/relations/makesRecommendation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty" />
    <rdfs:label>makes</rdfs:label>
    <rdfs:comment>A Donor Advisor makes a Grant Recommendation requesting that their Donor-Advised Fund make an award.</rdfs:comment>
    <rdfs:domain rdf:resource="https://egovender.github.io/NPOGraph/ontology/donor-advisor" />
    <rdfs:range rdf:resource="https://egovender.github.io/NPOGraph/ontology/grant-recommendation" />
    <rdfs:isDefinedBy rdf:resource="https://github.com/EGovender/NPOGraph/blob/main/docs/08-organizations-roles-and-arrangements.md" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/NPOGraph/ontology/relations/assessesOutcome">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty" />
    <rdfs:label>assesses</rdfs:label>
    <rdfs:comment>An Evaluation assesses whether a grant-funded project achieved its intended Outcomes.</rdfs:comment>
    <rdfs:domain rdf:resource="https://egovender.github.io/NPOGraph/ontology/evaluation" />
    <rdfs:range rdf:resource="https://egovender.github.io/NPOGraph/ontology/outcome" />
    <rdfs:isDefinedBy rdf:resource="https://github.com/EGovender/NPOGraph/blob/main/docs/03-relationships.md#the-grant-lifecycle-end-to-end" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/NPOGraph/ontology/relations/assessesOutput">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty" />
    <rdfs:label>assesses</rdfs:label>
    <rdfs:comment>An Evaluation assesses whether a grant-funded project achieved its intended Outputs.</rdfs:comment>
    <rdfs:domain rdf:resource="https://egovender.github.io/NPOGraph/ontology/evaluation" />
    <rdfs:range rdf:resource="https://egovender.github.io/NPOGraph/ontology/output" />
    <rdfs:isDefinedBy rdf:resource="https://github.com/EGovender/NPOGraph/blob/main/docs/03-relationships.md#the-grant-lifecycle-end-to-end" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/NPOGraph/ontology/relations/actsOnBehalfOf">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty" />
    <rdfs:label>acts on behalf of</rdfs:label>
    <rdfs:comment>A Fiscal Sponsor stands in for a Grantee that lacks independent legal status to receive an Award directly.</rdfs:comment>
    <rdfs:domain rdf:resource="https://egovender.github.io/NPOGraph/ontology/fiscal-sponsor" />
    <rdfs:range rdf:resource="https://egovender.github.io/NPOGraph/ontology/grantee" />
    <rdfs:isDefinedBy rdf:resource="https://github.com/EGovender/NPOGraph/blob/main/docs/03-relationships.md#organizational-relationships" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/NPOGraph/ontology/relations/supports">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty" />
    <rdfs:label>supports</rdfs:label>
    <rdfs:comment>A Fiscal Sponsorship Arrangement supports a specific Sponsored Project carried out under the fiscal sponsor's umbrella.</rdfs:comment>
    <rdfs:domain rdf:resource="https://egovender.github.io/NPOGraph/ontology/fiscal-sponsorship-arrangement" />
    <rdfs:range rdf:resource="https://egovender.github.io/NPOGraph/ontology/sponsored-project" />
    <rdfs:isDefinedBy rdf:resource="https://github.com/EGovender/NPOGraph/blob/main/docs/08-organizations-roles-and-arrangements.md" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/NPOGraph/ontology/relations/heldBy">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty" />
    <rdfs:label>is held by</rdfs:label>
    <rdfs:comment>A Fund is held and administered by an Organization.</rdfs:comment>
    <rdfs:domain rdf:resource="https://egovender.github.io/NPOGraph/ontology/fund" />
    <rdfs:range rdf:resource="https://egovender.github.io/NPOGraph/ontology/organization" />
    <rdfs:isDefinedBy rdf:resource="https://github.com/EGovender/NPOGraph/blob/main/docs/08-organizations-roles-and-arrangements.md" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/NPOGraph/ontology/relations/maintainsGrantProgram">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty" />
    <rdfs:label>maintains</rdfs:label>
    <rdfs:comment>A Funder maintains one or more Grant Programs, each of which issues Funding Opportunities over time.</rdfs:comment>
    <rdfs:domain rdf:resource="https://egovender.github.io/NPOGraph/ontology/funder" />
    <rdfs:range rdf:resource="https://egovender.github.io/NPOGraph/ontology/grant-program" />
    <rdfs:isDefinedBy rdf:resource="https://github.com/EGovender/NPOGraph/blob/main/docs/03-relationships.md#the-grant-lifecycle-end-to-end" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/NPOGraph/ontology/relations/mayRequireLetterOfInquiry">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty" />
    <rdfs:label>may require</rdfs:label>
    <rdfs:comment>A Funding Opportunity may require a Letter of Inquiry before a full Application is invited.</rdfs:comment>
    <rdfs:domain rdf:resource="https://egovender.github.io/NPOGraph/ontology/funding-opportunity" />
    <rdfs:range rdf:resource="https://egovender.github.io/NPOGraph/ontology/letter-of-inquiry" />
    <rdfs:isDefinedBy rdf:resource="https://github.com/EGovender/NPOGraph/blob/main/docs/03-relationships.md#the-grant-lifecycle-end-to-end" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/NPOGraph/ontology/relations/occursDuringFundingCycle">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty" />
    <rdfs:label>occurs during</rdfs:label>
    <rdfs:comment>A Funding Opportunity is issued within a defined Funding Cycle.</rdfs:comment>
    <rdfs:domain rdf:resource="https://egovender.github.io/NPOGraph/ontology/funding-opportunity" />
    <rdfs:range rdf:resource="https://egovender.github.io/NPOGraph/ontology/funding-cycle" />
    <rdfs:isDefinedBy rdf:resource="https://github.com/EGovender/NPOGraph/blob/main/docs/03-relationships.md#the-grant-lifecycle-end-to-end" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/NPOGraph/ontology/relations/specifiesEligibilityCriteria">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty" />
    <rdfs:label>specifies</rdfs:label>
    <rdfs:comment>A Funding Opportunity specifies the Eligibility Criteria an applicant must meet.</rdfs:comment>
    <rdfs:domain rdf:resource="https://egovender.github.io/NPOGraph/ontology/funding-opportunity" />
    <rdfs:range rdf:resource="https://egovender.github.io/NPOGraph/ontology/eligibility-criteria" />
    <rdfs:isDefinedBy rdf:resource="https://github.com/EGovender/NPOGraph/blob/main/docs/03-relationships.md#the-grant-lifecycle-end-to-end" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/NPOGraph/ontology/relations/responsibleForComplianceRequirement">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty" />
    <rdfs:label>is responsible for</rdfs:label>
    <rdfs:comment>A Grant Administrator is typically responsible for tracking Compliance Requirements.</rdfs:comment>
    <rdfs:domain rdf:resource="https://egovender.github.io/NPOGraph/ontology/grant-administrator" />
    <rdfs:range rdf:resource="https://egovender.github.io/NPOGraph/ontology/compliance-requirement" />
    <rdfs:isDefinedBy rdf:resource="https://github.com/EGovender/NPOGraph/blob/main/docs/03-relationships.md#organizational-relationships" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/NPOGraph/ontology/relations/responsibleForReport">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty" />
    <rdfs:label>is responsible for</rdfs:label>
    <rdfs:comment>A Grant Administrator is typically responsible for Report submission.</rdfs:comment>
    <rdfs:domain rdf:resource="https://egovender.github.io/NPOGraph/ontology/grant-administrator" />
    <rdfs:range rdf:resource="https://egovender.github.io/NPOGraph/ontology/report" />
    <rdfs:isDefinedBy rdf:resource="https://github.com/EGovender/NPOGraph/blob/main/docs/03-relationships.md#organizational-relationships" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/NPOGraph/ontology/relations/attachesComplianceRequirement">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty" />
    <rdfs:label>attaches</rdfs:label>
    <rdfs:comment>A Grant Agreement attaches Compliance Requirements, including a Reporting Schedule.</rdfs:comment>
    <rdfs:domain rdf:resource="https://egovender.github.io/NPOGraph/ontology/grant-agreement" />
    <rdfs:range rdf:resource="https://egovender.github.io/NPOGraph/ontology/compliance-requirement" />
    <rdfs:isDefinedBy rdf:resource="https://github.com/EGovender/NPOGraph/blob/main/docs/03-relationships.md#the-grant-lifecycle-end-to-end" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/NPOGraph/ontology/relations/mayIncludeMatchingRequirement">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty" />
    <rdfs:label>may include</rdfs:label>
    <rdfs:comment>A Grant Agreement may include a Matching Requirement.</rdfs:comment>
    <rdfs:domain rdf:resource="https://egovender.github.io/NPOGraph/ontology/grant-agreement" />
    <rdfs:range rdf:resource="https://egovender.github.io/NPOGraph/ontology/matching-requirement" />
    <rdfs:isDefinedBy rdf:resource="https://github.com/EGovender/NPOGraph/blob/main/docs/03-relationships.md#the-grant-lifecycle-end-to-end" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/NPOGraph/ontology/relations/maySpecifyRestrictedFunding">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty" />
    <rdfs:label>may specify</rdfs:label>
    <rdfs:comment>A Grant Agreement's Terms and Conditions may classify the award as Restricted Funding.</rdfs:comment>
    <rdfs:domain rdf:resource="https://egovender.github.io/NPOGraph/ontology/grant-agreement" />
    <rdfs:range rdf:resource="https://egovender.github.io/NPOGraph/ontology/restricted-funding" />
    <rdfs:isDefinedBy rdf:resource="https://github.com/EGovender/NPOGraph/blob/main/docs/03-relationships.md#the-grant-lifecycle-end-to-end" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/NPOGraph/ontology/relations/maySpecifyUnrestrictedFunding">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty" />
    <rdfs:label>may specify</rdfs:label>
    <rdfs:comment>A Grant Agreement's Terms and Conditions may classify the award as Unrestricted Funding.</rdfs:comment>
    <rdfs:domain rdf:resource="https://egovender.github.io/NPOGraph/ontology/grant-agreement" />
    <rdfs:range rdf:resource="https://egovender.github.io/NPOGraph/ontology/unrestricted-funding" />
    <rdfs:isDefinedBy rdf:resource="https://github.com/EGovender/NPOGraph/blob/main/docs/03-relationships.md#the-grant-lifecycle-end-to-end" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/NPOGraph/ontology/relations/specifiesTermsAndConditions">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty" />
    <rdfs:label>specifies</rdfs:label>
    <rdfs:comment>A Grant Agreement specifies Terms and Conditions, including whether funding is restricted or unrestricted.</rdfs:comment>
    <rdfs:domain rdf:resource="https://egovender.github.io/NPOGraph/ontology/grant-agreement" />
    <rdfs:range rdf:resource="https://egovender.github.io/NPOGraph/ontology/terms-and-conditions" />
    <rdfs:isDefinedBy rdf:resource="https://github.com/EGovender/NPOGraph/blob/main/docs/03-relationships.md#the-grant-lifecycle-end-to-end" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/NPOGraph/ontology/relations/fundedBy">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty" />
    <rdfs:label>is funded by</rdfs:label>
    <rdfs:comment>A Grant Program is funded by a Fund -- the pool of financial resources backing the program's giving strategy.</rdfs:comment>
    <rdfs:domain rdf:resource="https://egovender.github.io/NPOGraph/ontology/grant-program" />
    <rdfs:range rdf:resource="https://egovender.github.io/NPOGraph/ontology/fund" />
    <rdfs:isDefinedBy rdf:resource="https://github.com/EGovender/NPOGraph/blob/main/docs/08-organizations-roles-and-arrangements.md" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/NPOGraph/ontology/relations/issuesFundingOpportunity">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty" />
    <rdfs:label>issues</rdfs:label>
    <rdfs:comment>A Grant Program issues Funding Opportunities during defined Funding Cycles.</rdfs:comment>
    <rdfs:domain rdf:resource="https://egovender.github.io/NPOGraph/ontology/grant-program" />
    <rdfs:range rdf:resource="https://egovender.github.io/NPOGraph/ontology/funding-opportunity" />
    <rdfs:isDefinedBy rdf:resource="https://github.com/EGovender/NPOGraph/blob/main/docs/03-relationships.md#the-grant-lifecycle-end-to-end" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/NPOGraph/ontology/relations/concernsFund">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty" />
    <rdfs:label>concerns</rdfs:label>
    <rdfs:comment>A Grant Recommendation concerns a specific Fund -- ordinarily a Donor-Advised Fund -- that would pay for the recommended award.</rdfs:comment>
    <rdfs:domain rdf:resource="https://egovender.github.io/NPOGraph/ontology/grant-recommendation" />
    <rdfs:range rdf:resource="https://egovender.github.io/NPOGraph/ontology/fund" />
    <rdfs:isDefinedBy rdf:resource="https://github.com/EGovender/NPOGraph/blob/main/docs/08-organizations-roles-and-arrangements.md" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/NPOGraph/ontology/relations/leadsToAward">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty" />
    <rdfs:label>leads to</rdfs:label>
    <rdfs:comment>A Grant Recommendation the sponsoring organization accepts leads to an Award, mirroring how a Decision results in an Award in the direct-grant path.</rdfs:comment>
    <rdfs:domain rdf:resource="https://egovender.github.io/NPOGraph/ontology/grant-recommendation" />
    <rdfs:range rdf:resource="https://egovender.github.io/NPOGraph/ontology/award" />
    <rdfs:isDefinedBy rdf:resource="https://github.com/EGovender/NPOGraph/blob/main/docs/08-organizations-roles-and-arrangements.md" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/NPOGraph/ontology/relations/recommendsRecipient">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty" />
    <rdfs:label>recommends</rdfs:label>
    <rdfs:comment>A Grant Recommendation recommends a specific Organization as the award's recipient.</rdfs:comment>
    <rdfs:domain rdf:resource="https://egovender.github.io/NPOGraph/ontology/grant-recommendation" />
    <rdfs:range rdf:resource="https://egovender.github.io/NPOGraph/ontology/organization" />
    <rdfs:isDefinedBy rdf:resource="https://github.com/EGovender/NPOGraph/blob/main/docs/08-organizations-roles-and-arrangements.md" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/NPOGraph/ontology/relations/mayRequestBudgetModification">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty" />
    <rdfs:label>may request</rdfs:label>
    <rdfs:comment>Over the life of an Award, the Grantee may request a Budget Modification.</rdfs:comment>
    <rdfs:domain rdf:resource="https://egovender.github.io/NPOGraph/ontology/grantee" />
    <rdfs:range rdf:resource="https://egovender.github.io/NPOGraph/ontology/budget-modification" />
    <rdfs:isDefinedBy rdf:resource="https://github.com/EGovender/NPOGraph/blob/main/docs/03-relationships.md#the-grant-lifecycle-end-to-end" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/NPOGraph/ontology/relations/submitsApplication">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty" />
    <rdfs:label>submits</rdfs:label>
    <rdfs:comment>A Grantee (or a project operating under a Fiscal Sponsor) submits an Application in response to a Funding Opportunity.</rdfs:comment>
    <rdfs:domain rdf:resource="https://egovender.github.io/NPOGraph/ontology/grantee" />
    <rdfs:range rdf:resource="https://egovender.github.io/NPOGraph/ontology/application" />
    <rdfs:isDefinedBy rdf:resource="https://github.com/EGovender/NPOGraph/blob/main/docs/03-relationships.md#the-grant-lifecycle-end-to-end" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/NPOGraph/ontology/relations/disbursedAsPayment">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty" />
    <rdfs:label>is disbursed as</rdfs:label>
    <rdfs:comment>An Installment is disbursed as a Payment once any Payment Condition is satisfied.</rdfs:comment>
    <rdfs:domain rdf:resource="https://egovender.github.io/NPOGraph/ontology/installment" />
    <rdfs:range rdf:resource="https://egovender.github.io/NPOGraph/ontology/payment" />
    <rdfs:isDefinedBy rdf:resource="https://github.com/EGovender/NPOGraph/blob/main/docs/03-relationships.md#the-grant-lifecycle-end-to-end" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/NPOGraph/ontology/relations/mayHavePaymentCondition">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty" />
    <rdfs:label>may have</rdfs:label>
    <rdfs:comment>An Installment may carry a Payment Condition that must be met before it is disbursed.</rdfs:comment>
    <rdfs:domain rdf:resource="https://egovender.github.io/NPOGraph/ontology/installment" />
    <rdfs:range rdf:resource="https://egovender.github.io/NPOGraph/ontology/payment-condition" />
    <rdfs:isDefinedBy rdf:resource="https://github.com/EGovender/NPOGraph/blob/main/docs/03-relationships.md#the-grant-lifecycle-end-to-end" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/NPOGraph/ontology/relations/hasLegalForm">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty" />
    <rdfs:label>has legal form</rdfs:label>
    <rdfs:comment>An Organization has a legal form describing what it fundamentally is under law, independent of any role it plays.</rdfs:comment>
    <rdfs:domain rdf:resource="https://egovender.github.io/NPOGraph/ontology/organization" />
    <rdfs:range rdf:resource="https://egovender.github.io/NPOGraph/ontology/organization-type" />
    <rdfs:isDefinedBy rdf:resource="https://github.com/EGovender/NPOGraph/blob/main/docs/08-organizations-roles-and-arrangements.md" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/NPOGraph/ontology/relations/participatesIn">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty" />
    <rdfs:label>participates in</rdfs:label>
    <rdfs:comment>An Organization participates in a Philanthropic Arrangement, independent of tracking which specific role it occupies there.</rdfs:comment>
    <rdfs:domain rdf:resource="https://egovender.github.io/NPOGraph/ontology/organization" />
    <rdfs:range rdf:resource="https://egovender.github.io/NPOGraph/ontology/philanthropic-arrangement" />
    <rdfs:isDefinedBy rdf:resource="https://github.com/EGovender/NPOGraph/blob/main/docs/08-organizations-roles-and-arrangements.md" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/NPOGraph/ontology/relations/playsRole">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty" />
    <rdfs:label>plays</rdfs:label>
    <rdfs:comment>An Organization plays one or more Organization Roles, each a contextual, independently-scoped occupancy rather than a permanent trait.</rdfs:comment>
    <rdfs:domain rdf:resource="https://egovender.github.io/NPOGraph/ontology/organization" />
    <rdfs:range rdf:resource="https://egovender.github.io/NPOGraph/ontology/organization-role" />
    <rdfs:isDefinedBy rdf:resource="https://github.com/EGovender/NPOGraph/blob/main/docs/08-organizations-roles-and-arrangements.md" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/NPOGraph/ontology/relations/appliesWithin">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty" />
    <rdfs:label>applies within</rdfs:label>
    <rdfs:comment>An Organization Role is scoped to the Philanthropic Arrangement it was granted within, so the same organization can hold different roles in different arrangements.</rdfs:comment>
    <rdfs:domain rdf:resource="https://egovender.github.io/NPOGraph/ontology/organization-role" />
    <rdfs:range rdf:resource="https://egovender.github.io/NPOGraph/ontology/philanthropic-arrangement" />
    <rdfs:isDefinedBy rdf:resource="https://github.com/EGovender/NPOGraph/blob/main/docs/08-organizations-roles-and-arrangements.md" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/NPOGraph/ontology/relations/organizationRoleAppliesWithinOrganization">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty" />
    <rdfs:label>applies within</rdfs:label>
    <rdfs:comment>An Organization Role can also be scoped directly to an Organization rather than an Arrangement -- e.g. a Contractor, Vendor, Service Provider, Employer, or Partner role is naturally scoped to which organization it relates to, not to a Philanthropic Arrangement. A distinct predicate from rel-organization-role-applies-within for the same reason Phase 3.7 Milestone 1's Person relationships needed distinct names: the generator requires every relationship predicate to be globally unique, so one predicate can't have two different declared object concepts. Broadening this into a true Role-appliesWithin-Context union (Award, Application, Agreement, Fund, Grant Program, Funding Opportunity, Project, Review, Payment, Decision, per the Phase 3.7 roadmap) is deferred until real worked-example data actually needs one of those specific contexts -- adding all of them speculatively now, each as its own distinct predicate, would be exactly the kind of premature abstraction this project avoids.</rdfs:comment>
    <rdfs:domain rdf:resource="https://egovender.github.io/NPOGraph/ontology/organization-role" />
    <rdfs:range rdf:resource="https://egovender.github.io/NPOGraph/ontology/organization" />
    <rdfs:isDefinedBy rdf:resource="https://github.com/EGovender/NPOGraph/blob/main/docs/08-organizations-roles-and-arrangements.md" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/NPOGraph/ontology/relations/brokenIntoInstallment">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty" />
    <rdfs:label>is broken into</rdfs:label>
    <rdfs:comment>A Payment Schedule is broken into Installments.</rdfs:comment>
    <rdfs:domain rdf:resource="https://egovender.github.io/NPOGraph/ontology/payment-schedule" />
    <rdfs:range rdf:resource="https://egovender.github.io/NPOGraph/ontology/installment" />
    <rdfs:isDefinedBy rdf:resource="https://github.com/EGovender/NPOGraph/blob/main/docs/03-relationships.md#the-grant-lifecycle-end-to-end" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/NPOGraph/ontology/relations/affiliatedWith">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty" />
    <rdfs:label>is affiliated with</rdfs:label>
    <rdfs:comment>A Person is affiliated with an Organization, independent of which specific Person Role(s) they occupy there.</rdfs:comment>
    <rdfs:domain rdf:resource="https://egovender.github.io/NPOGraph/ontology/person" />
    <rdfs:range rdf:resource="https://egovender.github.io/NPOGraph/ontology/organization" />
    <rdfs:isDefinedBy rdf:resource="https://github.com/EGovender/NPOGraph/blob/main/docs/02-core-concepts.md#organizational-entities" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/NPOGraph/ontology/relations/personPlaysRole">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty" />
    <rdfs:label>plays</rdfs:label>
    <rdfs:comment>A Person plays one or more Person Roles, each a contextual, independently-scoped occupancy rather than a permanent trait -- mirroring how an Organization plays Organization Roles (rel-organization-plays-role). A distinct predicate rather than a shared `playsRole` because the generator requires every relationship predicate to be globally unique (one fixed subject/object concept pair each); broadening `playsRole` into a real Person-or-Organization union predicate is a generator change deferred to when it's actually needed.</rdfs:comment>
    <rdfs:domain rdf:resource="https://egovender.github.io/NPOGraph/ontology/person" />
    <rdfs:range rdf:resource="https://egovender.github.io/NPOGraph/ontology/person-role" />
    <rdfs:isDefinedBy rdf:resource="https://github.com/EGovender/NPOGraph/blob/main/docs/02-core-concepts.md#organizational-entities" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/NPOGraph/ontology/relations/personRoleAppliesWithin">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty" />
    <rdfs:label>applies within</rdfs:label>
    <rdfs:comment>A Person Role is scoped to the Organization it was granted within. This is the minimal case needed to make Person Role usable; broadening it to Award, Application, Agreement, and other contexts (matching how Organization Role's own context is broadened) is Phase 3.7 Milestone 2's job -- which will also need to resolve the same predicate-uniqueness constraint noted on personPlaysRole above, likely by generalizing the generator to support a shared predicate across a union of object concepts.</rdfs:comment>
    <rdfs:domain rdf:resource="https://egovender.github.io/NPOGraph/ontology/person-role" />
    <rdfs:range rdf:resource="https://egovender.github.io/NPOGraph/ontology/organization" />
    <rdfs:isDefinedBy rdf:resource="https://github.com/EGovender/NPOGraph/blob/main/docs/02-core-concepts.md#organizational-entities" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/NPOGraph/ontology/relations/administeredBy">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty" />
    <rdfs:label>is administered by</rdfs:label>
    <rdfs:comment>A Philanthropic Arrangement is administered by an Organization, such as a fiscal sponsor or fund administrator.</rdfs:comment>
    <rdfs:domain rdf:resource="https://egovender.github.io/NPOGraph/ontology/philanthropic-arrangement" />
    <rdfs:range rdf:resource="https://egovender.github.io/NPOGraph/ontology/organization" />
    <rdfs:isDefinedBy rdf:resource="https://github.com/EGovender/NPOGraph/blob/main/docs/08-organizations-roles-and-arrangements.md" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/NPOGraph/ontology/relations/associatedWithGrantProgram">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty" />
    <rdfs:label>is associated with</rdfs:label>
    <rdfs:comment>A Program Officer is associated with one or more Grant Programs and typically owns the Review and monitoring relationship for Awards made under them.</rdfs:comment>
    <rdfs:domain rdf:resource="https://egovender.github.io/NPOGraph/ontology/program-officer" />
    <rdfs:range rdf:resource="https://egovender.github.io/NPOGraph/ontology/grant-program" />
    <rdfs:isDefinedBy rdf:resource="https://github.com/EGovender/NPOGraph/blob/main/docs/03-relationships.md#organizational-relationships" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/NPOGraph/ontology/relations/regrantsTo">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty" />
    <rdfs:label>regrants to</rdfs:label>
    <rdfs:comment>A Regranting Arrangement regrants funds to a downstream Organization, distinct from the Organization that supplied the funds originally.</rdfs:comment>
    <rdfs:domain rdf:resource="https://egovender.github.io/NPOGraph/ontology/regranting-arrangement" />
    <rdfs:range rdf:resource="https://egovender.github.io/NPOGraph/ontology/organization" />
    <rdfs:isDefinedBy rdf:resource="https://github.com/EGovender/NPOGraph/blob/main/docs/08-organizations-roles-and-arrangements.md" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/NPOGraph/ontology/relations/assessedAgainstLogicModel">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty" />
    <rdfs:label>is assessed against</rdfs:label>
    <rdfs:comment>Reports are assessed against the project's Logic Model in terms of Outputs and Outcomes.</rdfs:comment>
    <rdfs:domain rdf:resource="https://egovender.github.io/NPOGraph/ontology/report" />
    <rdfs:range rdf:resource="https://egovender.github.io/NPOGraph/ontology/logic-model" />
    <rdfs:isDefinedBy rdf:resource="https://github.com/EGovender/NPOGraph/blob/main/docs/03-relationships.md#the-grant-lifecycle-end-to-end" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/NPOGraph/ontology/relations/assessedAgainstTheoryOfChange">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty" />
    <rdfs:label>is assessed against</rdfs:label>
    <rdfs:comment>Reports are assessed against the project's Theory of Change in terms of Outputs and Outcomes.</rdfs:comment>
    <rdfs:domain rdf:resource="https://egovender.github.io/NPOGraph/ontology/report" />
    <rdfs:range rdf:resource="https://egovender.github.io/NPOGraph/ontology/theory-of-change" />
    <rdfs:isDefinedBy rdf:resource="https://github.com/EGovender/NPOGraph/blob/main/docs/03-relationships.md#the-grant-lifecycle-end-to-end" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/NPOGraph/ontology/relations/obligatesReport">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty" />
    <rdfs:label>obligates</rdfs:label>
    <rdfs:comment>A Reporting Schedule obligates the Grantee to submit Reports on a defined cadence.</rdfs:comment>
    <rdfs:domain rdf:resource="https://egovender.github.io/NPOGraph/ontology/reporting-schedule" />
    <rdfs:range rdf:resource="https://egovender.github.io/NPOGraph/ontology/report" />
    <rdfs:isDefinedBy rdf:resource="https://github.com/EGovender/NPOGraph/blob/main/docs/03-relationships.md#the-grant-lifecycle-end-to-end" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/NPOGraph/ontology/relations/conductedByReviewer">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty" />
    <rdfs:label>is conducted by</rdfs:label>
    <rdfs:comment>A Review is conducted by one or more Reviewers.</rdfs:comment>
    <rdfs:domain rdf:resource="https://egovender.github.io/NPOGraph/ontology/review" />
    <rdfs:range rdf:resource="https://egovender.github.io/NPOGraph/ontology/reviewer" />
    <rdfs:isDefinedBy rdf:resource="https://github.com/EGovender/NPOGraph/blob/main/docs/03-relationships.md#the-grant-lifecycle-end-to-end" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/NPOGraph/ontology/relations/evaluatedAgainstReviewCriteria">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty" />
    <rdfs:label>is evaluated against</rdfs:label>
    <rdfs:comment>A Review evaluates an Application against published Review Criteria.</rdfs:comment>
    <rdfs:domain rdf:resource="https://egovender.github.io/NPOGraph/ontology/review" />
    <rdfs:range rdf:resource="https://egovender.github.io/NPOGraph/ontology/review-criteria" />
    <rdfs:isDefinedBy rdf:resource="https://github.com/EGovender/NPOGraph/blob/main/docs/03-relationships.md#the-grant-lifecycle-end-to-end" />
  </rdf:Description>

      "type": "owl:DatatypeProperty",
      "label": "Scope",
      "comment": "Any limits on what this role occupancy covers (e.g., a specific program or geography), if narrower than the arrangement itself.",
      "domain": "npo:organization-role",
      "range": "xsd:string",
      "group": "governance",
      "required": false,
      "cardinality": "one"
    },
    {
      "id": "npoprop:organization-role-status",
      "type": "owl:DatatypeProperty",
      "label": "Status",
      "comment": "Whether this role occupancy is currently in effect.",
      "domain": "npo:organization-role",
      "range": "xsd:string",
      "group": "lifecycle",
      "required": true,
      "cardinality": "one",
      "allowedValues": [
        "active",
        "inactive",
        "terminated"
      ]
    },
    {
      "id": "npoprop:organization-tax-identifier",
      "type": "owl:DatatypeProperty",
      "label": "Tax Identifier",
      "comment": "The organization's tax identification number (e.g., an EIN), if applicable and disclosed.",
      "domain": "npo:organization",
      "range": "xsd:string",
      "group": "classification",
      "required": false,
      "cardinality": "one"
    },
    {
      "id": "npoprop:organization-tax-status",
      "type": "owl:DatatypeProperty",
      "label": "Tax Status",
      "comment": "The organization's tax-exemption status, independent of its legal form.",
      "domain": "npo:organization",
      "range": "xsd:string",
      "group": "classification",
      "required": false,
      "cardinality": "one",
      "allowedValues": [
        "tax-exempt-501c3",
        "tax-exempt-other",
        "taxable",
        "government-exempt",
        "unknown"
      ]
    },
    {
      "id": "npoprop:output-unit",
      "type": "owl:DatatypeProperty",
      "label": "Unit",
      "comment": "The unit the Output is counted in, e.g. \"workshops\" or \"people served\".",
      "domain": "npo:output",
      "range": "xsd:string",
      "group": "classification",
      "required": false,
      "cardinality": "one"
    },
    {
      "id": "npoprop:payment-amount",
      "type": "owl:DatatypeProperty",
      "label": "Amount",
      "comment": "The actual amount transferred in this Payment.",
      "domain": "npo:payment",
      "range": "xsd:decimal",
      "group": "financial",
      "required": true,
      "cardinality": "one"
    },
    {
      "id": "npoprop:payment-condition-condition-type",
      "type": "owl:DatatypeProperty",
      "label": "Condition Type",
      "comment": "What kind of condition must be satisfied before the corresponding Payment is released.",
      "domain": "npo:payment-condition",
      "range": "xsd:string",
      "group": "governance",
      "required": true,
      "cardinality": "one",
      "allowedValues": [
        "report-required",
        "milestone-required",
        "none"
      ]
    },
    {
      "id": "npoprop:payment-currency",
      "type": "owl:DatatypeProperty",
      "label": "Currency",
      "comment": "The currency the Payment was made in, if not implied by context.",
      "domain": "npo:payment",
      "range": "xsd:string",
      "group": "financial",
      "required": false,
      "cardinality": "one"
    },
    {
      "id": "npoprop:payment-date",
      "type": "owl:DatatypeProperty",
      "label": "Payment Date",
      "comment": "When the Payment was sent or received.",
      "domain": "npo:payment",
      "range": "xsd:date",
      "group": "lifecycle",
      "required": false,
      "cardinality": "one"
    },
    {
      "id": "npoprop:payment-schedule-status",
      "type": "owl:DatatypeProperty",
      "label": "Status",
      "comment": "Whether all Installments in the Payment Schedule have been disbursed.",
      "domain": "npo:payment-schedule",
      "range": "xsd:string",
      "group": "lifecycle",
      "required": true,
      "cardinality": "one",
      "allowedValues": [
        "active",
        "completed"
      ]
    },
    {
      "id": "npoprop:payment-status",
      "type": "owl:DatatypeProperty",
      "label": "Status",
      "comment": "Where the Payment stands in transit.",
      "domain": "npo:payment",
      "range": "xsd:string",
      "group": "lifecycle",
      "required": true,
      "cardinality": "one",
      "allowedValues": [
        "pending",
        "sent",
        "received"
      ]
    },
    {
      "id": "npoprop:philanthropic-arrangement-effective-date",
      "type": "owl:DatatypeProperty",
      "label": "Effective Date",
      "comment": "When the arrangement took effect.",
      "domain": "npo:philanthropic-arrangement",
      "range": "xsd:date",
      "group": "lifecycle",
      "required": false,
      "cardinality": "one"
    },
    {
      "id": "npoprop:philanthropic-arrangement-governing-document",
      "type": "owl:DatatypeProperty",
      "label": "Governing Document",
      "comment": "The name or type of document that formally establishes the arrangement (e.g., a fiscal sponsorship agreement).",
      "domain": "npo:philanthropic-arrangement",
      "range": "xsd:string",
      "group": "governance",
      "required": false,
      "cardinality": "one"
    },
    {
      "id": "npoprop:philanthropic-arrangement-status",
      "type": "owl:DatatypeProperty",
      "label": "Status",
      "comment": "Whether the arrangement is currently active.",
      "domain": "npo:philanthropic-arrangement",
      "range": "xsd:string",
      "group": "lifecycle",
      "required": true,
      "cardinality": "one",
      "allowedValues": [
        "active",
        "terminated",
        "pending"
      ]
    },
    {
      "id": "npoprop:philanthropic-arrangement-termination-date",
      "type": "owl:DatatypeProperty",
      "label": "Termination Date",
      "comment": "When the arrangement ended, if it has.",
      "domain": "npo:philanthropic-arrangement",
      "range": "xsd:date",
      "group": "lifecycle",
      "required": false,
      "cardinality": "one"
    },
    {
      "id": "npoprop:report-due-date",
      "type": "owl:DatatypeProperty",
      "label": "Due Date",
      "comment": "When the Report is due per the Reporting Schedule.",
      "domain": "npo:report",
      "range": "xsd:date",
      "group": "lifecycle",
      "required": true,
      "cardinality": "one"
    },
    {
      "id": "npoprop:report-report-type",
      "type": "owl:DatatypeProperty",
      "label": "Report Type",
      "comment": "Whether the Report covers narrative progress, financial use of funds, or both.",
      "domain": "npo:report",
      "range": "xsd:string",
      "group": "classification",
      "required": true,
      "cardinality": "one",
      "allowedValues": [
        "narrative",
        "financial",
        "both"
      ]
    },
    {
      "id": "npoprop:report-status",
      "type": "owl:DatatypeProperty",
      "label": "Status",
      "comment": "Where the Report stands with the funder.",
      "domain": "npo:report",
      "range": "xsd:string",
      "group": "lifecycle",
      "required": true,
      "cardinality": "one",
      "allowedValues": [
        "not-started",
        "submitted",
        "accepted",
        "rejected"
      ]
    },
    {
      "id": "npoprop:report-submitted-date",
      "type": "owl:DatatypeProperty",
      "label": "Submitted Date",
      "comment": "When the Report was actually submitted, once it has been.",
      "domain": "npo:report",
      "range": "xsd:date",
      "group": "lifecycle",
      "required": false,
      "cardinality": "one"
    },
    {
      "id": "npoprop:reporting-schedule-frequency",
      "type": "owl:DatatypeProperty",
      "label": "Frequency",
      "comment": "How often Reports are due under this Reporting Schedule.",
      "domain": "npo:reporting-schedule",
      "range": "xsd:string",
      "group": "lifecycle",
      "required": true,
      "cardinality": "one",
      "allowedValues": [
        "monthly",
        "quarterly",
        "annual",
        "one-time"
      ]
    },
    {
      "id": "npoprop:review-status",
      "type": "owl:DatatypeProperty",
      "label": "Status",
      "comment": "Where the Review currently stands.",
      "domain": "npo:review",
      "range": "xsd:string",
      "group": "lifecycle",
      "required": true,
      "cardinality": "one",
      "allowedValues": [
        "pending",
        "in-progress",
        "completed"
      ]
    },
    {
      "id": "npoprop:site-visit-scheduled-date",
      "type": "owl:DatatypeProperty",
      "label": "Scheduled Date",
      "comment": "When the Site Visit is scheduled to occur.",
      "domain": "npo:site-visit",
      "range": "xsd:date",
      "group": "lifecycle",
      "required": true,
      "cardinality": "one"
    },
    {
      "id": "npoprop:site-visit-status",
      "type": "owl:DatatypeProperty",
      "label": "Status",
      "comment": "Whether the Site Visit has happened yet.",
      "domain": "npo:site-visit",
      "range": "xsd:string",
      "group": "lifecycle",
      "required": true,
      "cardinality": "one",
      "allowedValues": [
        "scheduled",
        "completed",
        "cancelled"
      ]
    },
    {
      "id": "npoprop:sponsored-project-end-date",
      "type": "owl:DatatypeProperty",
      "label": "End Date",
      "comment": "When the Sponsored Project ended, if it has.",
      "domain": "npo:sponsored-project",
      "range": "xsd:date",
      "group": "lifecycle",
      "required": false,
      "cardinality": "one"
    },
    {
      "id": "npoprop:sponsored-project-start-date",
      "type": "owl:DatatypeProperty",
      "label": "Start Date",
      "comment": "When the Sponsored Project began operating under its Fiscal Sponsor.",
      "domain": "npo:sponsored-project",
      "range": "xsd:date",
      "group": "lifecycle",
      "required": false,
      "cardinality": "one"
    },
    {
      "id": "npoprop:sponsored-project-status",
      "type": "owl:DatatypeProperty",
      "label": "Status",
      "comment": "Whether the Sponsored Project is still operating under its Fiscal Sponsor.",
      "domain": "npo:sponsored-project",
      "range": "xsd:string",
      "group": "lifecycle",
      "required": true,
      "cardinality": "one",
      "allowedValues": [
        "active",
        "completed",
        "terminated"
      ]
    },
    {
      "id": "npoprop:terms-and-conditions-restriction-type",
      "type": "owl:DatatypeProperty",
      "label": "Restriction Type",
      "comment": "Whether the funding governed by these Terms and Conditions is Restricted or Unrestricted Funding.",
      "domain": "npo:terms-and-conditions",
      "range": "xsd:string",
      "group": "governance",
      "required": true,
      "cardinality": "one",
      "allowedValues": [
        "restricted",
        "unrestricted"
      ]
    },
    {
      "id": "nporule:rule-amendment-not-retroactive",
      "type": "npo:BusinessRule",
      "label": "An Amendment is forward-looking, not retroactive",
      "comment": "An Amendment changes the Grant Agreement going forward; it does not retroactively alter Payments or Reports already completed under the prior terms.",
      "isDefinedBy": "https://github.com/EGovender/NPOGraph/blob/main/docs/03-relationships.md#key-relationship-rules-draft",
      "appliesTo": [
        "npo:amendment",
        "npo:grant-agreement",
        "npo:payment",
        "npo:report"
      ]
    },
    {
      "id": "nporule:rule-award-requires-approved-decision",
      "type": "npo:BusinessRule",
      "label": "An Award requires an approved Decision",
      "comment": "An Award cannot exist without a Decision that approved an Application (or, in funder-initiated giving, an equivalent internal approval).",
      "isDefinedBy": "https://github.com/EGovender/NPOGraph/blob/main/docs/03-relationships.md#key-relationship-rules-draft",
      "appliesTo": [
        "npo:award",
        "npo:decision",
        "npo:application"
      ]
    },
    {
      "id": "nporule:rule-closeout-requires-payments-and-reports",
      "type": "npo:BusinessRule",
      "label": "Closeout requires both financial and reporting conditions",
      "comment": "Closeout requires both financial conditions (all Payments made or the award formally reduced) and reporting conditions (all required Reports accepted) to be true.",
      "isDefinedBy": "https://github.com/EGovender/NPOGraph/blob/main/docs/03-relationships.md#key-relationship-rules-draft",
      "appliesTo": [
        "npo:closeout",
        "npo:payment",
        "npo:report"
      ]
    },
    {
      "id": "nporule:rule-compliance-requirement-attaches-to-award",
      "type": "npo:BusinessRule",
      "label": "A Compliance Requirement attaches to a specific Award, not the Grantee in the abstract",
      "comment": "A Compliance Requirement is always attached to a specific Award, not to the Grantee in the abstract -- the same organization can be in good standing on one award and delinquent on another.",
      "isDefinedBy": "https://github.com/EGovender/NPOGraph/blob/main/docs/03-relationships.md#key-relationship-rules-draft",
      "appliesTo": [
        "npo:compliance-requirement",
        "npo:award",
        "npo:grantee"
      ]
    },
    {
      "id": "nporule:rule-grant-recommendation-non-binding",
      "type": "npo:BusinessRule",
      "label": "A Grant Recommendation is non-binding",
      "comment": "A Donor Advisor's Grant Recommendation does not itself obligate a Donor-Advised Fund to make an Award; the fund's sponsoring organization retains final legal authority over whether to accept it.",
      "isDefinedBy": "https://github.com/EGovender/NPOGraph/blob/main/docs/08-organizations-roles-and-arrangements.md",
      "appliesTo": [
        "npo:grant-recommendation",
        "npo:donor-advised-fund",
        "npo:award"
      ]
    },
    {
      "id": "nporule:rule-installment-condition-before-payment",
      "type": "npo:BusinessRule",
      "label": "An Installment's Payment Condition must be met before release",
      "comment": "An Installment's Payment Condition, if any, must be satisfied before its corresponding Payment is released.",
      "isDefinedBy": "https://github.com/EGovender/NPOGraph/blob/main/docs/03-relationships.md#key-relationship-rules-draft",
      "appliesTo": [
        "npo:installment",
        "npo:payment-condition",
        "npo:payment"
      ]
    },
    {
      "id": "nporule:rule-payment-requires-award-and-agreement",
      "type": "npo:BusinessRule",
      "label": "A Payment requires an Award, typically with a Grant Agreement",
      "comment": "A Payment cannot exist without an Award and, typically, a Grant Agreement -- though some funders disburse an initial installment before a fully signed agreement is in place.",
      "isDefinedBy": "https://github.com/EGovender/NPOGraph/blob/main/docs/03-relationships.md#key-relationship-rules-draft",
      "appliesTo": [
        "npo:payment",
        "npo:award",
        "npo:grant-agreement"
      ]
    }
  ]
}

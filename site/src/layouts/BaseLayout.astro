---
import '../styles/global.css';
import { concepts, ontologyVersion, ontologyLastUpdated } from '../data/ontology';
import SearchBox from '../components/SearchBox';

interface Props {
  title: string;
  description?: string;
  /** true: the existing 1200px-capped layout (concept catalogue, concept
   * pages, design tool). 'full': a much wider cap, for the graph explorer,
   * where canvas space is the whole point. */
  wide?: boolean | 'full';
}

const { title, description = 'CommonGood Atlas: an open knowledge platform for grantmaking.', wide = false } = Astro.props;
const base = import.meta.env.BASE_URL;

const pageTitle = `${title} · CommonGood Atlas`;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImageURL = new URL(`${base}og-image.png`, Astro.site);

interface NavItem {
  label: string;
  href: string;
  external?: boolean;
}

const NAV_ITEMS: NavItem[] = [
  { label: 'Explore', href: `${base}explore` },
  { label: 'Concepts', href: `${base}concepts` },
  { label: 'Model', href: `${base}design` },
  { label: 'Worked Example', href: `${base}story` },
  { label: 'Community', href: 'https://github.com/EGovender/commongood-atlas', external: true },
];

function trimSlash(path: string): string {
  return path.length > 1 && path.endsWith('/') ? path.slice(0, -1) : path;
}
const currentPath = trimSlash(Astro.url.pathname);

const lastUpdatedDisplay = ontologyLastUpdated
  ? new Date(ontologyLastUpdated).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })
  : null;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#14304D" />
    <link rel="canonical" href={canonicalURL} />
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
    <link rel="alternate icon" href={`${base}favicon.ico`} sizes="48x48" />
    <link rel="apple-touch-icon" href={`${base}apple-touch-icon.png`} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:ital,wght@0,400;0,500;0,600;0,700;0,800;1,400&display=swap"
      rel="stylesheet"
    />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:site_name" content="CommonGood Atlas" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href={base}>
        <img class="brand-icon" src={`${base}favicon.svg`} alt="" width="28" height="28" />
        <span class="brand-text">CommonGood<span class="brand-text-accent"> Atlas</span></span>
      </a>
      <button
        type="button"
        class="nav-toggle"
        aria-expanded="false"
        aria-controls="site-nav"
        aria-label="Toggle navigation menu"
      >
        <span class="nav-toggle-bar"></span>
        <span class="nav-toggle-bar"></span>
        <span class="nav-toggle-bar"></span>
      </button>
      <nav id="site-nav">
        {
          NAV_ITEMS.map((item) => {
            const isActive = !item.external && trimSlash(item.href) === currentPath;
            return item.external ? (
              <a href={item.href} target="_blank" rel="noreferrer">
                {item.label}
              </a>
            ) : (
              <a href={item.href} aria-current={isActive ? 'page' : undefined} class={isActive ? 'active' : ''}>
                {item.label}
              </a>
            );
          })
        }
        <SearchBox client:load compact concepts={concepts} base={base} />
        <a class="home-cta home-cta-primary nav-get-started" href={`${base}story`}>Get Started</a>
      </nav>
    </header>
    <main class={wide === 'full' ? 'full-bleed' : wide ? 'wide' : ''}>
      <slot />
    </main>
    <footer class="site-footer">
      CommonGood Atlas is an open-source project.{' '}
      <a href="https://github.com/EGovender/commongood-atlas/blob/main/CONTRIBUTING.md">Contribute on GitHub</a>.{' '}
      <span class="footer-version">
        Ontology v{ontologyVersion}
        {lastUpdatedDisplay && <>{' '}&middot; updated {lastUpdatedDisplay}</>}
      </span>
    </footer>
    <script>
      const toggle = document.querySelector('.nav-toggle');
      const nav = document.getElementById('site-nav');
      if (toggle && nav) {
        toggle.addEventListener('click', () => {
          const open = nav.classList.toggle('open');
          toggle.setAttribute('aria-expanded', String(open));
        });
        nav.querySelectorAll('a').forEach((link) => {
          link.addEventListener('click', () => {
            nav.classList.remove('open');
            toggle.setAttribute('aria-expanded', 'false');
          });
        });
        document.addEventListener('keydown', (e) => {
          if (e.key === 'Escape' && nav.classList.contains('open')) {
            nav.classList.remove('open');
            toggle.setAttribute('aria-expanded', 'false');
          }
        });
      }
    </script>
  </body>
</html>

---
import '../styles/global.css';
import '../styles/page-shell.css';
import '../styles/interior-pages.css';
import '../styles/navigation.css';
import { concepts, ontologyVersion, ontologyLastUpdated } from '../data/ontology';
import SearchBox from '../components/SearchBox';

interface Props {
  title: string;
  description?: string;
  /** true: the existing 1200px-capped layout (concept catalogue, concept
   * pages, design tool). 'full': a much wider cap, for the graph explorer,
   * where canvas space is the whole point. 'home': no cap/padding at all --
   * the homepage's full-bleed dark hero band centers its own content via a
   * container element. */
  wide?: boolean | 'full' | 'home';
}

const { title, description = 'CommonGood Atlas is an open knowledge foundation for nonprofit and philanthropic operations.', wide = false } = Astro.props;
const base = import.meta.env.BASE_URL;

// A "pageHero" slot renders full-bleed above the width-capped content --
// pages that don't fill it (the homepage manages its own full-bleed hero
// directly) simply get an empty slot, so this is backwards compatible.
const contentClass =
  wide === 'full' ? 'site-content-full' : wide === 'home' ? 'site-content-home' : wide ? 'site-content-wide' : 'site-content-standard';

const pageTitle = `${title} · CommonGood Atlas`;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImageURL = new URL(`${base}og-image.png`, Astro.site);

interface NavLink {
  label: string;
  href: string;
}

interface NavGroup {
  label: string;
  links: NavLink[];
}

const GITHUB_URL = 'https://github.com/EGovender/commongood-atlas';

// Grouped nav data drives both the desktop dropdowns and the mobile grouped
// list from one source, so the two can never drift out of sync. See
// site/src/styles/navigation.css for how .site-nav-trigger (desktop button)
// and .site-nav-section-label (mobile heading) present the same group.label
// differently per breakpoint, and CONTRIBUTING.md/the site footer for the
// same six destinations kept one click away even though they're now nested.
const NAV_GROUPS: NavGroup[] = [
  {
    label: 'Explore',
    links: [
      { label: 'Graph Explorer', href: `${base}explore` },
      { label: 'Concept Library', href: `${base}concepts` },
    ],
  },
  {
    label: 'Use',
    links: [
      { label: 'Model Your Program', href: `${base}design` },
      { label: 'Worked Example', href: `${base}story` },
    ],
  },
  {
    label: 'About',
    links: [{ label: 'Contribute', href: `${base}contribute` }],
  },
];

function trimSlash(path: string): string {
  return path.length > 1 && path.endsWith('/') ? path.slice(0, -1) : path;
}
const currentPath = trimSlash(Astro.url.pathname);

function isLinkActive(href: string): boolean {
  const target = trimSlash(href);
  return currentPath === target || currentPath.startsWith(`${target}/`);
}
function isGroupActive(group: NavGroup): boolean {
  return group.links.some((link) => isLinkActive(link.href));
}
// The homepage already has its own full-size SearchBox below the hero, so
// the header's persistent compact one is redundant there -- only render it
// on every other page.
const isHome = currentPath === trimSlash(base);

const lastUpdatedDisplay = ontologyLastUpdated
  ? new Date(ontologyLastUpdated).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })
  : null;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#082f5b" />
    <link rel="canonical" href={canonicalURL} />
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
    <link rel="alternate icon" href={`${base}favicon.ico`} sizes="48x48" />
    <link rel="apple-touch-icon" href={`${base}apple-touch-icon.png`} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:ital,wght@0,400;0,500;0,600;0,700;0,800;1,400&display=swap"
      rel="stylesheet"
    />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:site_name" content="CommonGood Atlas" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href={base}>
        <img class="brand-icon" src={`${base}favicon.svg`} alt="" width="40" height="40" />
        <span class="brand-text">CommonGood<span class="brand-text-accent"> Atlas</span></span>
      </a>
      <button
        type="button"
        class="nav-toggle"
        aria-expanded="false"
        aria-controls="site-nav"
        aria-label="Toggle navigation menu"
      >
        <span class="nav-toggle-bar"></span>
        <span class="nav-toggle-bar"></span>
        <span class="nav-toggle-bar"></span>
      </button>
      <nav id="site-nav" aria-label="Primary navigation">
        {
          NAV_GROUPS.map((group) => {
            const groupId = `nav-${group.label.toLowerCase()}`;
            const active = isGroupActive(group);
            return (
              <div class="site-nav-group">
                <button
                  type="button"
                  class={`site-nav-trigger${active ? ' active' : ''}`}
                  aria-expanded="false"
                  aria-controls={groupId}
                >
                  {group.label}
                  <span class="site-nav-caret" aria-hidden="true">
                    &#9662;
                  </span>
                </button>
                <span class={`site-nav-section-label${active ? ' active' : ''}`}>{group.label}</span>
                <div id={groupId} class="site-nav-dropdown">
                  {group.links.map((link) => (
                    <a href={link.href} class="site-nav-link" aria-current={isLinkActive(link.href) ? 'page' : undefined}>
                      {link.label}
                    </a>
                  ))}
                </div>
              </div>
            );
          })
        }
        <a class="site-nav-external" href={GITHUB_URL} target="_blank" rel="noreferrer">
          GitHub <span aria-hidden="true">&#8599;</span>
        </a>
        {!isHome && <SearchBox client:load compact concepts={concepts} base={base} />}
      </nav>
    </header>
    <main class="site-main">
      <slot name="pageHero" />
      <div class={`site-content ${contentClass}`}>
        <slot />
      </div>
    </main>
    <footer class="site-footer">
      <nav class="site-footer-links" aria-label="Footer">
        <a href={`${base}explore`}>Graph Explorer</a>
        <a href={`${base}concepts`}>Concept Library</a>
        <a href={`${base}design`}>Model Your Program</a>
        <a href={`${base}story`}>Worked Example</a>
        <a href={`${base}contribute`}>Contribute</a>
        <a href={GITHUB_URL} target="_blank" rel="noreferrer">
          GitHub <span aria-hidden="true">&#8599;</span>
        </a>
      </nav>
      <p>
        CommonGood Atlas is an open-source project.{' '}
        <a href="https://github.com/EGovender/commongood-atlas/blob/main/CONTRIBUTING.md">Contribute on GitHub</a>.{' '}
        <span class="footer-version">
          Ontology v{ontologyVersion}
          {lastUpdatedDisplay && <>{' '}&middot; updated {lastUpdatedDisplay}</>}
        </span>
      </p>
    </footer>
    <script>
      const toggle = document.querySelector('.nav-toggle');
      const nav = document.getElementById('site-nav');
      if (toggle && nav) {
        toggle.addEventListener('click', () => {
          const open = nav.classList.toggle('open');
          toggle.setAttribute('aria-expanded', String(open));
        });
        nav.querySelectorAll('a').forEach((link) => {
          link.addEventListener('click', () => {
            nav.classList.remove('open');
            toggle.setAttribute('aria-expanded', 'false');
          });
        });
        document.addEventListener('keydown', (e) => {
          if (e.key === 'Escape' && nav.classList.contains('open')) {
            nav.classList.remove('open');
            toggle.setAttribute('aria-expanded', 'false');
          }
        });
      }

      // Desktop Explore/Use/About dropdowns -- click/keyboard only, never
      // hover-only. Inert on mobile (the trigger button is hidden there via
      // navigation.css and the dropdown is always statically visible), but
      // the listeners are harmless no-ops in that state.
      const navGroups = Array.from(document.querySelectorAll<HTMLElement>('.site-nav-group'));

      function closeGroup(group: HTMLElement) {
        group.classList.remove('open');
        group.querySelector('.site-nav-trigger')?.setAttribute('aria-expanded', 'false');
      }

      function closeAllGroups(except?: HTMLElement) {
        navGroups.forEach((group) => {
          if (group !== except) closeGroup(group);
        });
      }

      navGroups.forEach((group) => {
        const trigger = group.querySelector('.site-nav-trigger');
        trigger?.addEventListener('click', () => {
          const isOpen = group.classList.contains('open');
          closeAllGroups(group);
          group.classList.toggle('open', !isOpen);
          trigger.setAttribute('aria-expanded', String(!isOpen));
        });
      });

      document.addEventListener('click', (e) => {
        if (!(e.target instanceof Node)) return;
        navGroups.forEach((group) => {
          if (group.classList.contains('open') && !group.contains(e.target as Node)) closeGroup(group);
        });
      });

      document.addEventListener('keydown', (e) => {
        if (e.key !== 'Escape') return;
        const openGroup = navGroups.find((group) => group.classList.contains('open'));
        if (openGroup) {
          closeGroup(openGroup);
          openGroup.querySelector<HTMLElement>('.site-nav-trigger')?.focus();
        }
      });
    </script>
  </body>
</html>

---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  wide?: boolean;
}

const { title, description = 'NPOGraph: an open knowledge platform for grantmaking.', wide = false } = Astro.props;
const base = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · NPOGraph</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#4BA188" />
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
    <link rel="alternate icon" href={`${base}favicon.ico`} sizes="48x48" />
    <link rel="apple-touch-icon" href={`${base}apple-touch-icon.png`} />
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href={base}>
        <img class="brand-icon" src={`${base}favicon.svg`} alt="" width="28" height="28" />
        <span class="brand-text">NPO<span class="brand-text-accent">Graph</span></span>
      </a>
      <nav>
        <a href={base}>Home</a>
        <a href={`${base}explore`}>Explore</a>
        <a href={`${base}concepts`}>Concepts</a>
        <a href={`${base}design`}>Design</a>
        <a href={`${base}story`}>Story</a>
        <a href="https://github.com/EGovender/NPOGraph" target="_blank" rel="noreferrer">GitHub</a>
      </nav>
    </header>
    <main class={wide ? 'wide' : ''}>
      <slot />
    </main>
    <footer class="site-footer">
      NPOGraph is an open-source project.{' '}
      <a href="https://github.com/EGovender/NPOGraph/blob/main/CONTRIBUTING.md">Contribute on GitHub</a>.
    </footer>
  </body>
</html>

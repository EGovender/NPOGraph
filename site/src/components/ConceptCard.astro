---
// One concept card in the /concepts catalogue. Rendered by both the
// category view and the alphabetical view (concepts/index.astro), carrying
// data-* attributes that the page's filter script reads -- so the base
// markup is fully static/no-JS-safe (every concept is already visible) and
// the script only ever hides/shows what's already rendered, never
// re-renders the list from scratch.
interface Props {
  id: string;
  label: string;
  definition: string;
  aliases: string[];
  category: string;
  parentId: string | null;
  parentLabel: string | null;
  hasExample: boolean;
  hasProperties: boolean;
  hasRelationships: boolean;
  hasRules: boolean;
  hasLegalNote?: boolean;
  categoryColorLight: string;
  categoryColorDark: string;
  base: string;
}

const {
  id,
  label,
  definition,
  aliases,
  category,
  parentId,
  parentLabel,
  hasExample,
  hasProperties,
  hasRelationships,
  hasRules,
  hasLegalNote,
  categoryColorLight,
  categoryColorDark,
  base,
} = Astro.props;
---

<li
  class="card concept-card"
  data-concept-id={id}
  data-category={category}
  data-label={label.toLowerCase()}
  data-has-example={hasExample ? '1' : '0'}
  data-has-properties={hasProperties ? '1' : '0'}
  data-has-relationships={hasRelationships ? '1' : '0'}
  data-has-rules={hasRules ? '1' : '0'}
  style={`--concept-accent: light-dark(${categoryColorLight}, ${categoryColorDark});`}
>
  <div class="concept-card-header">
    <span
      class="search-result-swatch"
      style={`background: light-dark(${categoryColorLight}, ${categoryColorDark});`}
    />
    <a href={`${base}concepts/${id}`} class="concept-card-label">{label}</a>
    {hasLegalNote && (
      <span class="badge concept-card-legal-badge" title="Has a legal-review note">
        Legal note
      </span>
    )}
  </div>
  {
    parentId && parentLabel && (
      <p class="muted concept-card-meta">
        Specializes <a href={`${base}concepts/${parentId}`}>{parentLabel}</a>
      </p>
    )
  }
  {aliases.length > 0 && <p class="muted concept-card-meta">Also known as: {aliases.join(', ')}</p>}
  <p class="secondary concept-card-def">{definition}</p>
</li>

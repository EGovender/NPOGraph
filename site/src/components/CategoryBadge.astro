---
import { getCategory } from '../data/categories';

interface Props {
  categoryId: string;
}

const { categoryId } = Astro.props;
const category = getCategory(categoryId);
---

<span class="badge">
  <span class="swatch" style={`background: light-dark(${category.colorLight}, ${category.colorDark})`}></span>
  {category.label}
</span>

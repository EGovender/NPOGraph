---
import BaseLayout from '../layouts/BaseLayout.astro';
import SearchBox from '../components/SearchBox';
import { concepts, relationships, ontologyVersion, ontologyLastUpdated, machineFormats } from '../data/ontology';
import '../styles/home.css';

const base = import.meta.env.BASE_URL;

const lastUpdatedDisplay = ontologyLastUpdated
  ? new Date(ontologyLastUpdated).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })
  : null;
---

<BaseLayout
  title="Home"
  description="CommonGood Atlas is an open data model for grantmaking and nonprofit operations, defining shared concepts for applications, awards, payments, compliance, outcomes, organizations, and more."
  wide="home"
>
  <section class="cg-home-hero">
    <div class="cg-home-hero-inner">
      <div>
        <img class="cg-home-mark" src={`${base}brand/mark-on-dark.svg`} alt="" width="64" height="64" />
        <span class="cg-home-kicker">Open data model for grantmaking</span>
        <span class="cg-home-kicker-rule" aria-hidden="true"></span>
        <h1 class="cg-home-title">Make grantmaking data <strong>mean the same thing everywhere.</strong></h1>
        <p class="cg-home-copy">
          CommonGood Atlas defines how applications, awards, payments, reports, compliance, outcomes,
          organizations, and roles fit together, so teams and systems can work from the same model.
        </p>
        <p class="cg-home-note">
          Built for grantmaking practitioners, nonprofit-technology teams, software vendors, researchers,
          and data architects.
        </p>
        <div class="cg-home-actions">
          <a class="cg-home-cta-primary" href={`${base}story`}>See a grant from start to finish</a>
          <a class="cg-home-cta-secondary" href={`${base}concepts`}>Browse concepts</a>
        </div>
        <p class="cg-home-expert-link">
          Already work with ontologies? <a href={`${base}explore`}>Open the graph explorer &rarr;</a>
        </p>
      </div>
      <img
        class="cg-home-hero-visual"
        src={`${base}brand/hero-network.png`}
        alt=""
        aria-hidden="true"
        width="640"
        height="640"
      />
    </div>
  </section>

  <div class="cg-home-container">
    <p class="cg-home-status">
      <span class="badge cg-home-status-badge">PRE-ALPHA</span>
      <span class="cg-home-status-sep" aria-hidden="true">&middot;</span>
      <span>Ontology v{ontologyVersion}</span>
      {lastUpdatedDisplay && (
        <>
          <span class="cg-home-status-sep" aria-hidden="true">&middot;</span>
          <span>Updated {lastUpdatedDisplay}</span>
        </>
      )}
      <span class="cg-home-status-sep" aria-hidden="true">&middot;</span>
      <span>{concepts.length} concepts</span>
      <span class="cg-home-status-sep" aria-hidden="true">&middot;</span>
      <span>{relationships.length} relationships</span>
      <span class="cg-home-status-sep" aria-hidden="true">&middot;</span>
      <a href="https://github.com/EGovender/commongood-atlas" target="_blank" rel="noreferrer">Open source</a>
    </p>

    <section class="cg-home-paths" aria-label="Choose your starting point">
      <span class="cg-home-kicker cg-home-kicker--ink">Find your starting point</span>
      <h2 class="cg-home-paths-heading">Start with what you're trying to do</h2>
      <p class="secondary">You don't need to understand ontologies or knowledge graphs to use CommonGood Atlas.</p>

      <div class="cg-home-path-grid">
        <article class="card cg-home-path-card cg-home-path-card--featured">
          <span class="cg-home-path-index">01</span>
          <span class="badge">Best first stop</span>
          <h3 class="cg-home-path-card-title">Understand how a grant fits together</h3>
          <p class="secondary">
            Follow a fictional grant from application through award, payments, reporting, outcomes, and
            closeout.
          </p>
          <a class="home-cta home-cta-primary" href={`${base}story`}>Start the worked example &rarr;</a>
        </article>

        <article class="card cg-home-path-card">
          <span class="cg-home-path-index">02</span>
          <span class="badge">For program teams</span>
          <h3 class="cg-home-path-card-title">Map your organization's program</h3>
          <p class="secondary">
            Answer practical questions about your grantmaking process and identify the concepts your
            organization actually needs.
          </p>
          <a class="home-cta home-cta-primary" href={`${base}design`}>Model your program &rarr;</a>
        </article>

        <article class="card cg-home-path-card">
          <span class="cg-home-path-index">03</span>
          <span class="badge">For implementers</span>
          <h3 class="cg-home-path-card-title">Look up a concept or field</h3>
          <p class="secondary">
            Browse definitions, relationships, properties, rules, and machine-readable representations.
          </p>
          <a class="home-cta home-cta-primary" href={`${base}concepts`}>Browse all concepts &rarr;</a>
        </article>
      </div>
    </section>

    <section class="cg-home-search">
      <span class="cg-home-kicker cg-home-kicker--ink">Quick reference</span>
      <h2 class="cg-home-search-heading">Looking for a specific term?</h2>
      <p class="cg-home-search-copy secondary">
        Search the ontology directly for concepts such as applications, installments, compliance, fiscal
        sponsorship, or outcomes.
      </p>
      <SearchBox client:load concepts={concepts} base={base} />
    </section>
  </div>

  <section class="cg-home-usecases">
    <div class="cg-home-usecases-inner">
      <span class="cg-home-kicker">Practical interoperability</span>
      <h2 class="cg-home-usecases-heading">One model, across the systems you already use</h2>
      <p class="cg-home-usecases-copy">
        CommonGood Atlas is intended to make nonprofit and philanthropic data easier to define, exchange,
        document, and validate.
      </p>
      <ul class="cg-home-usecases-grid">
        <li>Standardize definitions across CRM, grants, and finance systems</li>
        <li>Design a new grants-management data model</li>
        <li>Document how awards, installments, payments, and reports relate</li>
        <li>Compare terminology across funders, grantees, and vendors</li>
        <li>Create shared reference data and validation rules</li>
        <li>Give technical and program teams a shared vocabulary</li>
      </ul>
    </div>
  </section>

  <div class="cg-home-container">
    <section class="cg-home-open">
      <span class="cg-home-kicker cg-home-kicker--ink">Open infrastructure</span>
      <h2 class="cg-home-open-heading">A shared model, not another grants platform</h2>
      <div class="cg-home-open-grid">
        <div>
          <p>
            CommonGood Atlas models how grantmaking works: funders, applications, reviews, awards, payments,
            compliance, outcomes, and the organizational roles and arrangements around them.
          </p>
          <p>
            Grantmaking is the first module. The longer-term goal is a broader, openly reviewable model for
            nonprofit operations.
          </p>
        </div>
        <aside class="card cg-home-resources-card">
          <h3>Use the model directly</h3>
          <p class="secondary">
            The underlying ontology is available in machine-readable formats, including OWL, RDF, and
            JSON-LD.
          </p>
          <ul class="cg-home-resources-list">
            <li>
              <a href="https://github.com/EGovender/commongood-atlas" target="_blank" rel="noreferrer">
                View the repository &#8599;
              </a>
            </li>
            <li>
              <a
                href="https://github.com/EGovender/commongood-atlas/blob/main/docs/00-vision.md"
                target="_blank"
                rel="noreferrer"
              >
                Read the vision &#8599;
              </a>
            </li>
            <li>
              <a
                href="https://github.com/EGovender/commongood-atlas/blob/main/docs/04-roadmap.md"
                target="_blank"
                rel="noreferrer"
              >
                View the roadmap &#8599;
              </a>
            </li>
          </ul>
          <ul class="cg-home-resources-sublist">
            {
              machineFormats.map((format) => (
                <li>
                  <a href={format.href} target="_blank" rel="noreferrer">
                    {format.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </aside>
      </div>
    </section>

    <p class="cg-home-prealpha">
      <strong>CommonGood Atlas is pre-alpha.</strong> The ontology and website are still taking shape.
      Concepts, relationships, technical representations, and interface behavior may change as the project
      develops.
    </p>
  </div>
</BaseLayout>

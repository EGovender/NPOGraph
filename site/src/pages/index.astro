---
import BaseLayout from '../layouts/BaseLayout.astro';
import SearchBox from '../components/SearchBox';
import { concepts, relationships } from '../data/ontology';

const base = import.meta.env.BASE_URL;
---

<BaseLayout title="Home">
  <section style="text-align: center; margin-bottom: 2.5rem;">
    <h1 style="margin-bottom: 0.25rem;">NPOGraph</h1>
    <p class="secondary" style="font-size: 1.1rem; margin-top: 0;">
      An open knowledge platform for understanding, designing, and improving grantmaking.
    </p>
  </section>

  <SearchBox client:load concepts={concepts} base={base} />

  <p class="muted" style="text-align: center; margin-top: 0.75rem;">
    {concepts.length} concepts · {relationships.length} relationships ·{' '}
    <a href={`${base}explore`}>explore the graph</a> ·{' '}
    <a href={`${base}concepts`}>browse all concepts</a>
  </p>

  <section style="margin-top: 3rem;">
    <h2>What is this?</h2>
    <p>
      NPOGraph models how grantmaking actually works — funders, applications, reviews, awards,
      payments, compliance, and outcomes — as a shared, openly reviewable ontology. This site is
      the interactive explorer for that ontology: search for a concept above, browse the full{' '}
      <a href={`${base}concepts`}>concept list</a>, or see how everything connects in the{' '}
      <a href={`${base}explore`}>graph explorer</a>.
    </p>
    <p>
      The underlying concepts, relationships, and machine-readable formats (OWL, RDF, JSON-LD)
      live in the <a href="https://github.com/EGovender/NPOGraph">NPOGraph repository</a>, along
      with the project's{' '}
      <a href="https://github.com/EGovender/NPOGraph/blob/main/docs/00-vision.md">vision</a>{' '}
      and <a href="https://github.com/EGovender/NPOGraph/blob/main/docs/04-roadmap.md">roadmap</a>.
    </p>
  </section>
</BaseLayout>

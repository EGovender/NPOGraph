---
import BaseLayout from '../layouts/BaseLayout.astro';
import SearchBox from '../components/SearchBox';
import { concepts, relationships, ontologyVersion, ontologyLastUpdated } from '../data/ontology';
import heroNetwork from '../icons/hero-network-dark.svg?raw';

const base = import.meta.env.BASE_URL;

const lastUpdatedDisplay = ontologyLastUpdated
  ? new Date(ontologyLastUpdated).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })
  : null;
---

<BaseLayout title="Home" wide="home">
  <section class="dark-hero">
    <div class="dark-hero-inner">
      <div>
        <img class="dark-hero-mark" src={`${base}brand/mark-on-dark.svg`} alt="" width="64" height="64" />
        <span class="dark-hero-eyebrow">Open Knowledge Ontology</span>
        <span class="dark-hero-eyebrow-rule" aria-hidden="true"></span>
        <h1 class="dark-hero-title">A shared language for grantmaking and <strong>nonprofit operations</strong></h1>
        <p class="dark-hero-copy">
          Every funder, grantee, and vendor models a "grant" a little differently. CommonGood Atlas is an
          open, precisely-defined ontology so the same concepts - application, award, payment, compliance,
          outcome - mean the same thing everywhere.
        </p>
        <p class="dark-hero-note">
          Built for grantmaking practitioners, nonprofit-technology teams, and the vendors and
          researchers who support them.
        </p>
        <div class="dark-hero-actions">
          <a class="dark-hero-cta" href={`${base}explore`}>Explore the Atlas</a>
        </div>
      </div>
      <div class="dark-hero-visual" set:html={heroNetwork} />
    </div>
  </section>

  <div class="home-container">
  <section class="journey-cards" aria-label="Choose your path">
    <div class="card journey-card">
      <h2 class="journey-card-title">Understand how grantmaking fits together</h2>
      <p class="secondary">For nonprofit leaders, program teams, and newcomers.</p>
      <a class="home-cta home-cta-primary" href={`${base}story`}>Start with a worked example</a>
    </div>
    <div class="card journey-card">
      <h2 class="journey-card-title">Map your organization's process</h2>
      <p class="secondary">Answer questions and identify the concepts that apply to your program.</p>
      <a class="home-cta home-cta-primary" href={`${base}design`}>Model your program</a>
    </div>
    <div class="card journey-card">
      <h2 class="journey-card-title">Explore the data model</h2>
      <p class="secondary">Search definitions, relationships, properties, rules, and technical formats.</p>
      <a class="home-cta home-cta-primary" href={`${base}concepts`}>Browse Concepts</a>
    </div>
  </section>

  <p class="secondary" style="text-align: center; margin: 1.25rem 0;">
    Already familiar with knowledge graphs?{' '}
    <a href={`${base}explore`}>Open the graph explorer &rarr;</a>
  </p>

  <SearchBox client:load concepts={concepts} base={base} />

  <p class="muted" style="text-align: center; margin-top: 0.75rem;">
    <strong>Pre-alpha:</strong> the ontology and this site are both still taking shape - concepts,
    relationships, and pages can change without notice.
  </p>
  <p class="muted" style="text-align: center; margin-top: 0.25rem;">
    Ontology v{ontologyVersion}
    {lastUpdatedDisplay && <>, updated {lastUpdatedDisplay}</>}
    {' '}· {concepts.length} concepts · {relationships.length} relationships
  </p>

  <section style="margin-top: 3rem;">
    <h2>What can CommonGood Atlas help with?</h2>
    <ul>
      <li>Standardize definitions across a CRM, grants platform, and finance system</li>
      <li>Design a new grants-management data model</li>
      <li>Document how awards, installments, payments, and reports relate</li>
      <li>Compare terminology used by funders, grantees, and software vendors</li>
      <li>Create shared reference data and validation rules</li>
    </ul>
  </section>

  <section style="margin-top: 2rem;">
    <h2>What is this?</h2>
    <p>
      CommonGood Atlas models how grantmaking actually works - funders, applications, reviews, awards,
      payments, compliance, and outcomes, plus the organizational roles and arrangements
      (fiscal sponsorship, donor-advised funds, regranting) that surround them - as a shared,
      openly reviewable ontology. This site is the interactive explorer for that ontology.
    </p>
    <p>
      Grantmaking is the first module; the goal is a broader ontology for nonprofit operations. See
      the project's{' '}
      <a href="https://github.com/EGovender/commongood-atlas/blob/main/docs/00-vision.md">vision</a>{' '}
      and <a href="https://github.com/EGovender/commongood-atlas/blob/main/docs/04-roadmap.md">roadmap</a>{' '}
      for where it's headed, or the{' '}
      <a href="https://github.com/EGovender/commongood-atlas">CommonGood Atlas repository</a> for the underlying
      concepts, relationships, and machine-readable formats (OWL, RDF, JSON-LD).
    </p>
  </section>
  </div>
</BaseLayout>

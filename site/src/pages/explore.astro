---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import GraphExplorer from '../components/GraphExplorer';

const base = import.meta.env.BASE_URL;
---

<BaseLayout title="Graph Explorer" description="Browse the CommonGood Atlas ontology as an interactive graph." wide="full">
  <PageHero
    slot="pageHero"
    eyebrow="Explore the model"
    title="Graph Explorer"
    description="See how grantmaking concepts connect. Start with the core grant lifecycle, search for a concept, or explore the full ontology."
  >
    <a slot="actions" href={`${base}concepts`}>Prefer a catalogue? Browse concepts &rarr;</a>
  </PageHero>
  <GraphExplorer client:load base={base} />
</BaseLayout>

---
import BaseLayout from '../layouts/BaseLayout.astro';
import DesignWizard from '../components/DesignWizard';

const base = import.meta.env.BASE_URL;
---

<BaseLayout
  title="Model Your Program"
  description="Answer a few questions about your grantmaking program and get a recommended subset of the NPOGraph ontology."
  wide
>
  <h1 style="margin-bottom: 0.25rem;">Model Your Program</h1>
  <p class="secondary" style="margin-top: 0; max-width: 65ch;">
    Answer questions about how your program actually works. The recommended concept list on the
    right updates as you go — a starting point for which parts of the ontology apply to you, not a
    determination of which concepts are "real."
  </p>
  <DesignWizard client:load base={base} />
</BaseLayout>

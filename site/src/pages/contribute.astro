---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import {
  suggestNewConceptUrl,
  suggestConceptChangeUrl,
  suggestRelationshipUrl,
  suggestPropertyUrl,
  suggestBusinessRuleUrl,
  suggestScenarioUrl,
  suggestReferenceUrl,
  suggestDocumentationUrl,
  reportSiteBugUrl,
  suggestFeatureUrl,
  otherFeedbackUrl,
} from '../data/contribution-links';

interface ContributionCard {
  title: string;
  description: string;
  href: string;
}

const knowledgeModelCards: ContributionCard[] = [
  {
    title: 'Suggest a New Concept',
    description: 'Something important to grantmaking is missing from the model.',
    href: suggestNewConceptUrl(),
  },
  {
    title: 'Change an Existing Concept',
    description: "A definition or concept doesn't match how things work.",
    href: suggestConceptChangeUrl(''),
  },
  {
    title: 'Suggest a Relationship',
    description: 'Two concepts should connect differently.',
    href: suggestRelationshipUrl(),
  },
  {
    title: 'Suggest a Property',
    description: 'A concept is missing an important attribute.',
    href: suggestPropertyUrl(''),
  },
  {
    title: 'Suggest a Business Rule',
    description: 'There is a condition, dependency, or exception we should capture.',
    href: suggestBusinessRuleUrl(''),
  },
  {
    title: 'Add a Scenario or Example',
    description: 'Show how the model behaves in an actual grantmaking situation.',
    href: suggestScenarioUrl(),
  },
];

const knowledgeBaseCards: ContributionCard[] = [
  {
    title: 'Add a Reference or Terminology Note',
    description: 'Suggest an industry reference, standard, source, or alternate term.',
    href: suggestReferenceUrl(),
  },
  {
    title: 'Documentation / Clarity',
    description: "Something is unclear, misleading, or difficult to understand.",
    href: suggestDocumentationUrl(),
  },
];

const siteCards: ContributionCard[] = [
  {
    title: 'Report a Site Problem',
    description: "Something isn't working.",
    href: reportSiteBugUrl(),
  },
  {
    title: 'Suggest a Feature',
    description: 'Suggest an improvement to the explorer or site.',
    href: suggestFeatureUrl(),
  },
];

const otherCard: ContributionCard = {
  title: 'Other Feedback',
  description: "Tell us what you've found and we'll work out where it belongs.",
  href: otherFeedbackUrl(),
};

// The last group ("Not Sure?") gets a distinct full-width featured callout
// below instead of a grid tile, so it's excluded from this list.
const groups = [
  { title: 'Improve the Knowledge Model', cards: knowledgeModelCards },
  { title: 'Improve the Knowledge Base', cards: knowledgeBaseCards },
  { title: 'Improve CommonGood Atlas', cards: siteCards },
];

// Matches CONTRIBUTING.md's actual status-label lifecycle exactly -- see
// its "Contribution lifecycle" section for the full detail this links to.
const lifecycleSteps = [
  { title: 'Propose', detail: 'Describe what you see in practice.' },
  { title: 'Review', detail: 'A maintainer evaluates it (may ask a follow-up question).' },
  { title: 'Decide', detail: 'Accepted, with the reasoning documented, or declined.' },
  { title: 'Publish', detail: 'An accepted change is merged and goes live.' },
];
---

<BaseLayout
  title="Contribute"
  description="Suggest a change to the CommonGood Atlas ontology or site - no GitHub or ontology experience required."
>
  <PageHero
    slot="pageHero"
    eyebrow="Open source community"
    title="Help improve CommonGood Atlas"
    description="CommonGood Atlas should reflect how nonprofit and philanthropic work happens in practice. If something is missing, unclear, or incorrect, your experience can help improve the model."
  >
    <a slot="actions" href="https://github.com/EGovender/commongood-atlas/blob/main/CONTRIBUTING.md" target="_blank" rel="noreferrer">
      View contribution guide &rarr;
    </a>
  </PageHero>

  <div class="page-callout">
    <strong>You don't need to know ontology terminology.</strong>
    <p style="margin: 0.4rem 0 0;">
      Describe what happens in practice. A contribution starts a discussion; it doesn't
      automatically change the model.
    </p>
  </div>

  <div class="contribute-lifecycle" aria-label="Contribution lifecycle">
    {
      lifecycleSteps.map((step, i) => (
        <>
          <div class="contribute-lifecycle-step">
            <span class="contribute-lifecycle-step-number">{String(i + 1).padStart(2, '0')}</span>
            <span>
              <span class="contribute-lifecycle-step-title">{step.title}</span>
              <span class="contribute-lifecycle-step-detail">{step.detail}</span>
            </span>
          </div>
          {i < lifecycleSteps.length - 1 && (
            <span class="contribute-lifecycle-arrow" aria-hidden="true">&rarr;</span>
          )}
        </>
      ))
    }
  </div>
  <p class="muted" style="margin-top: -0.75rem;">
    See the full{' '}
    <a href="https://github.com/EGovender/commongood-atlas/blob/main/CONTRIBUTING.md#contribution-lifecycle">
      contribution lifecycle
    </a>{' '}
    for how status labels move through review.
  </p>

  <h2 style="margin-top: 1.5rem;">What would you like to contribute?</h2>

  {
    groups.map((group, i) => (
      <section style="margin-top: 1.5rem;">
        <div class="contribute-group-header">
          <span class="contribute-group-number">{String(i + 1).padStart(2, '0')}</span>
          <h3 style="margin: 0;">{group.title}</h3>
        </div>
        <div class="contribute-grid">
          {group.cards.map((card) => (
            <a class="contribute-item" href={card.href} target="_blank" rel="noreferrer">
              <span class="contribute-item-title">
                {card.title}
                <span aria-hidden="true">&rarr;</span>
              </span>
              <span class="contribute-item-description">{card.description}</span>
            </a>
          ))}
        </div>
      </section>
    ))
  }

  <div class="contribute-featured">
    <div>
      <h3 class="contribute-featured-title">Not sure where your feedback belongs?</h3>
      <p class="contribute-featured-copy">Tell us what you noticed and we'll work out where it fits.</p>
    </div>
    <a class="home-cta contribute-featured-cta" href={otherCard.href} target="_blank" rel="noreferrer">
      Share other feedback &rarr;
    </a>
  </div>
</BaseLayout>

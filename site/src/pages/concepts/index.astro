---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import ConceptCard from '../../components/ConceptCard.astro';
import {
  concepts,
  getConcept,
  getExamplesForConcept,
  getPropertiesForConcept,
  getOutgoingRelationships,
  getIncomingRelationships,
  getBusinessRulesForConcept,
} from '../../data/ontology';
import { CATEGORIES, getCategory } from '../../data/categories';

const base = import.meta.env.BASE_URL;

const cards = concepts.map((c) => {
  const parent = c.subClassOf ? getConcept(c.subClassOf) : undefined;
  return {
    id: c.id,
    label: c.label,
    definition: c.definition,
    aliases: c.aliases,
    category: c.category,
    parentId: parent?.id ?? null,
    parentLabel: parent?.label ?? null,
    hasExample: getExamplesForConcept(c.id).length > 0,
    hasProperties: getPropertiesForConcept(c.id).length > 0,
    hasRelationships: getOutgoingRelationships(c.id).length + getIncomingRelationships(c.id).length > 0,
    hasRules: getBusinessRulesForConcept(c.id).length > 0,
    hasLegalNote: !!c.legalNote,
  };
});

const byCategory = CATEGORIES.map((category) => ({
  category,
  cards: cards.filter((c) => c.category === category.id).sort((a, b) => a.label.localeCompare(b.label)),
}));

const alphabetical = [...cards].sort((a, b) => a.label.localeCompare(b.label));
const letters = [...new Set(alphabetical.map((c) => c.label[0]?.toUpperCase() ?? '#'))];
const byLetter = letters.map((letter) => ({
  letter,
  cards: alphabetical.filter((c) => (c.label[0]?.toUpperCase() ?? '#') === letter),
}));
---

<BaseLayout title="Concepts" description="All core concepts in the CommonGood Atlas grantmaking ontology." wide>
  <PageHero
    slot="pageHero"
    eyebrow="Reference"
    title="Concept Library"
    description="Browse the shared definitions behind CommonGood Atlas, from organizations and applications to awards, payments, reporting, outcomes, and closeout."
  >
    <span slot="meta" class="page-hero-meta-item">{concepts.length} concepts</span>
    <span slot="meta" class="page-hero-meta-item">{CATEGORIES.length} categories</span>
    <span slot="meta" class="page-hero-meta-item">Open specification</span>
  </PageHero>

  <p class="secondary catalogue-status">
    <span id="visible-count">{concepts.length}</span> of {concepts.length} concepts. See{' '}
    <a href="https://github.com/EGovender/commongood-atlas/blob/main/docs/02-core-concepts.md">docs/02-core-concepts.md</a>{' '}
    for the source, or <a href={`${base}explore`}>explore them as a graph</a>.
  </p>

  <div class="catalogue-controls catalogue-controls-sticky page-panel">
    <input
      type="search"
      id="concept-search"
      placeholder='Search concepts (e.g. "installment", "compliance")'
      aria-label="Search concepts"
      class="search-input"
    />

    <div class="catalogue-row">
      <div class="catalogue-sort" role="group" aria-label="Sort order">
        <button type="button" class="sort-toggle active" data-sort="category" aria-pressed="true">By category</button>
        <button type="button" class="sort-toggle" data-sort="alphabetical" aria-pressed="false">A&ndash;Z</button>
      </div>

      <div class="catalogue-sort" role="group" aria-label="Card density">
        <button type="button" class="density-toggle active" data-density="grid" aria-pressed="true">Grid</button>
        <button type="button" class="density-toggle" data-density="compact" aria-pressed="false">Compact list</button>
      </div>

      <details class="catalogue-filters">
        <summary>Filters</summary>
        <div class="catalogue-filters-body">
          <fieldset>
            <legend>
              Category <button type="button" id="select-all-categories" class="link-button">Select all</button>
              &middot; <button type="button" id="clear-categories" class="link-button">Clear</button>
            </legend>
            {
              CATEGORIES.map((cat) => (
                <label>
                  <input type="checkbox" class="filter-category" value={cat.id} checked />
                  <span
                    class="search-result-swatch"
                    style={`background: light-dark(${cat.colorLight}, ${cat.colorDark});`}
                  />
                  {cat.label}
                </label>
              ))
            }
          </fieldset>
          <fieldset>
            <legend>Has (advanced)</legend>
            <label><input type="checkbox" class="filter-has" value="example" /> Worked example</label>
            <label><input type="checkbox" class="filter-has" value="properties" /> Properties</label>
            <label><input type="checkbox" class="filter-has" value="relationships" /> Relationships</label>
            <label><input type="checkbox" class="filter-has" value="rules" /> Business rules</label>
          </fieldset>
          <button type="button" id="clear-filters" class="home-cta">Clear filters</button>
        </div>
      </details>
    </div>

    <ul id="active-filter-chips" class="graph-filter-chips" hidden></ul>

    <span class="page-section-kicker category-jump-links-label">Jump to category</span>
    <nav id="category-jump-links" class="category-jump-links" aria-label="Jump to category">
      {
        CATEGORIES.map((cat) => (
          <a href={`#category-${cat.id}`}>
            <span class="search-result-swatch" style={`background: light-dark(${cat.colorLight}, ${cat.colorDark});`} />
            {cat.label}
          </a>
        ))
      }
    </nav>
  </div>

  <p id="empty-state" class="muted page-panel" hidden>
    No concepts match your filters. <button type="button" id="empty-clear" class="link-button">Clear filters</button>
    {' '}Can't find what you're looking for?{' '}
    <a id="empty-state-suggest" href="https://github.com/EGovender/commongood-atlas/issues/new?template=new-concept.yml" target="_blank" rel="noreferrer">
      Suggest a new concept
    </a>
  </p>

  <div id="catalogue-views">
    <div id="view-category">
      {
        byCategory.map(({ category, cards: inCategory }) => (
          <section class="concept-group" data-category-group={category.id} id={`category-${category.id}`}>
            <h2 class="concept-group-title">
              <span
                class="search-result-swatch"
                style={`background: light-dark(${category.colorLight}, ${category.colorDark}); margin-top: 0;`}
              />
              {category.label}
              <span class="concept-group-count">{inCategory.length}</span>
            </h2>
            <ul class="concept-card-list">
              {inCategory.map((c) => (
                <ConceptCard
                  {...c}
                  base={base}
                  categoryColorLight={category.colorLight}
                  categoryColorDark={category.colorDark}
                />
              ))}
            </ul>
          </section>
        ))
      }
    </div>

    <div id="view-alphabetical" hidden>
      {
        byLetter.map(({ letter, cards: inLetter }) => (
          <section class="concept-group" data-letter-group={letter}>
            <h2 class="concept-group-title concept-group-title-letter">{letter}</h2>
            <ul class="concept-card-list">
              {inLetter.map((c) => {
                const cat = getCategory(c.category);
                return (
                  <ConceptCard {...c} base={base} categoryColorLight={cat.colorLight} categoryColorDark={cat.colorDark} />
                );
              })}
            </ul>
          </section>
        ))
      }
    </div>
  </div>

  <script>
    import { concepts as allConcepts } from '../../data/ontology';
    import { CATEGORIES } from '../../data/categories';
    import { conceptSearchScore } from '../../data/search';

    const conceptsById = new Map(allConcepts.map((c) => [c.id, c]));
    const categoryLabels = new Map(CATEGORIES.map((c) => [c.id, c.label]));
    const HAS_LABELS: Record<string, string> = {
      example: 'Worked example',
      properties: 'Properties',
      relationships: 'Relationships',
      rules: 'Business rules',
    };

    const searchInput = document.getElementById('concept-search') as HTMLInputElement;
    const sortButtons = Array.from(document.querySelectorAll<HTMLButtonElement>('.sort-toggle'));
    const densityButtons = Array.from(document.querySelectorAll<HTMLButtonElement>('.density-toggle'));
    const categoryCheckboxes = Array.from(document.querySelectorAll<HTMLInputElement>('.filter-category'));
    const hasCheckboxes = Array.from(document.querySelectorAll<HTMLInputElement>('.filter-has'));
    const clearButtons = [document.getElementById('clear-filters'), document.getElementById('empty-clear')].filter(
      (el): el is HTMLButtonElement => el !== null
    );
    const selectAllCategoriesBtn = document.getElementById('select-all-categories');
    const clearCategoriesBtn = document.getElementById('clear-categories');
    const emptyState = document.getElementById('empty-state');
    const emptyStateSuggestLink = document.getElementById('empty-state-suggest') as HTMLAnchorElement | null;
    const visibleCountEl = document.getElementById('visible-count');
    const catalogueViews = document.getElementById('catalogue-views');
    const jumpLinksNav = document.getElementById('category-jump-links');
    const filterChipsList = document.getElementById('active-filter-chips');
    const views: Record<string, HTMLElement | null> = {
      category: document.getElementById('view-category'),
      alphabetical: document.getElementById('view-alphabetical'),
    };

    let activeSort: 'category' | 'alphabetical' = 'category';
    let activeDensity: 'grid' | 'compact' = 'grid';

    function readURLState() {
      const params = new URLSearchParams(location.search);
      const q = params.get('q');
      if (q) searchInput.value = q;

      const sort = params.get('sort');
      if (sort === 'alphabetical') activeSort = 'alphabetical';

      const density = params.get('density');
      if (density === 'compact') activeDensity = 'compact';

      const cat = params.get('cat');
      if (cat !== null) {
        const included = new Set(cat.split(',').filter(Boolean));
        categoryCheckboxes.forEach((cb) => {
          cb.checked = included.has(cb.value);
        });
      }

      const has = params.get('has');
      if (has !== null) {
        const included = new Set(has.split(',').filter(Boolean));
        hasCheckboxes.forEach((cb) => {
          cb.checked = included.has(cb.value);
        });
      }
    }

    function writeURLState() {
      const params = new URLSearchParams();
      const q = searchInput.value.trim();
      if (q) params.set('q', q);
      if (activeSort !== 'category') params.set('sort', activeSort);
      if (activeDensity !== 'grid') params.set('density', activeDensity);

      const uncheckedCategories = categoryCheckboxes.filter((cb) => !cb.checked);
      if (uncheckedCategories.length > 0) {
        params.set('cat', categoryCheckboxes.filter((cb) => cb.checked).map((cb) => cb.value).join(','));
      }

      const checkedHas = hasCheckboxes.filter((cb) => cb.checked).map((cb) => cb.value);
      if (checkedHas.length > 0) params.set('has', checkedHas.join(','));

      const qs = params.toString();
      const url = qs ? `${location.pathname}?${qs}` : location.pathname;
      history.replaceState(null, '', url);
    }

    function setActiveSort(sort: 'category' | 'alphabetical') {
      activeSort = sort;
      sortButtons.forEach((btn) => {
        const isActive = btn.dataset.sort === sort;
        btn.classList.toggle('active', isActive);
        btn.setAttribute('aria-pressed', String(isActive));
      });
      Object.entries(views).forEach(([key, el]) => {
        if (el) el.hidden = key !== sort;
      });
      if (jumpLinksNav) jumpLinksNav.hidden = sort !== 'category';
    }

    function setActiveDensity(density: 'grid' | 'compact') {
      activeDensity = density;
      densityButtons.forEach((btn) => {
        const isActive = btn.dataset.density === density;
        btn.classList.toggle('active', isActive);
        btn.setAttribute('aria-pressed', String(isActive));
      });
      if (catalogueViews) catalogueViews.classList.toggle('compact', density === 'compact');
    }

    function escapeRegExp(s: string) {
      return s.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
    }

    /** Wraps the search query in <mark> within a card's label/definition,
     * always working from the original text (stored on first run) so
     * repeated searches never nest marks or lose text. */
    function applyHighlight(el: Element | null, query: string) {
      if (!el) return;
      const node = el as HTMLElement;
      const original = node.dataset.original ?? (node.dataset.original = node.textContent ?? '');
      if (!query) {
        node.textContent = original;
        return;
      }
      const re = new RegExp(`(${escapeRegExp(query)})`, 'ig');
      if (!re.test(original)) {
        node.textContent = original;
        return;
      }
      node.innerHTML = original.replace(re, '<mark>$1</mark>');
    }

    interface FilterChip {
      key: string;
      label: string;
      onRemove: () => void;
    }

    function renderFilterChips() {
      if (!filterChipsList) return;
      const chips: FilterChip[] = [];
      for (const cb of categoryCheckboxes) {
        if (!cb.checked) {
          chips.push({
            key: `cat-${cb.value}`,
            label: `${categoryLabels.get(cb.value) ?? cb.value} hidden`,
            onRemove: () => {
              cb.checked = true;
              applyFilters();
            },
          });
        }
      }
      for (const cb of hasCheckboxes) {
        if (cb.checked) {
          chips.push({
            key: `has-${cb.value}`,
            label: `Has: ${HAS_LABELS[cb.value] ?? cb.value}`,
            onRemove: () => {
              cb.checked = false;
              applyFilters();
            },
          });
        }
      }
      const query = searchInput.value.trim();
      if (query) {
        chips.push({
          key: 'search',
          label: `Search: "${query}"`,
          onRemove: () => {
            searchInput.value = '';
            applyFilters();
          },
        });
      }

      filterChipsList.innerHTML = '';
      filterChipsList.hidden = chips.length === 0;
      for (const chip of chips) {
        const li = document.createElement('li');
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.className = 'graph-filter-chip';
        btn.innerHTML = `${chip.label} <span aria-hidden="true">&times;</span>`;
        btn.addEventListener('click', chip.onRemove);
        li.appendChild(btn);
        filterChipsList.appendChild(li);
      }
    }

    function applyFilters() {
      const query = searchInput.value.trim();
      const allowedCategories = new Set(categoryCheckboxes.filter((cb) => cb.checked).map((cb) => cb.value));
      const requiredHas = hasCheckboxes.filter((cb) => cb.checked).map((cb) => cb.value);

      document.querySelectorAll<HTMLLIElement>('.concept-card').forEach((card) => {
        const id = card.dataset.conceptId!;
        const concept = conceptsById.get(id);
        const category = card.dataset.category!;

        let matches = concept !== undefined && allowedCategories.has(category);
        if (matches && query) matches = conceptSearchScore(concept!, query) > 0;
        if (matches) {
          for (const flag of requiredHas) {
            if (card.dataset[`has${flag.charAt(0).toUpperCase()}${flag.slice(1)}`] !== '1') {
              matches = false;
              break;
            }
          }
        }

        card.hidden = !matches;
        applyHighlight(card.querySelector('.concept-card-label'), query);
        applyHighlight(card.querySelector('.concept-card-def'), query);
      });

      document.querySelectorAll<HTMLElement>('.concept-group').forEach((group) => {
        const groupCards = Array.from(group.querySelectorAll<HTMLLIElement>('.concept-card'));
        const groupVisible = groupCards.filter((c) => !c.hidden).length;
        group.hidden = groupVisible === 0;
        const countEl = group.querySelector('.concept-group-count');
        if (countEl) countEl.textContent = String(groupVisible);
      });

      // Cards exist (hidden or not) in BOTH views at once, so the headline
      // count and empty-state must only look at the currently active view,
      // not every .concept-card in the document.
      const activeViewEl = views[activeSort];
      const visibleInActiveView = activeViewEl
        ? Array.from(activeViewEl.querySelectorAll<HTMLLIElement>('.concept-card')).filter((c) => !c.hidden).length
        : 0;

      if (visibleCountEl) visibleCountEl.textContent = String(visibleInActiveView);

      const activeViewEmpty = visibleInActiveView === 0;
      if (emptyState) emptyState.hidden = !activeViewEmpty;
      if (emptyStateSuggestLink) {
        const query = searchInput?.value.trim() ?? '';
        const params = new URLSearchParams({ template: 'new-concept.yml' });
        if (query) {
          params.set('title', `[New Concept] ${query}`);
          params.set('concept', query);
        }
        emptyStateSuggestLink.href = `https://github.com/EGovender/commongood-atlas/issues/new?${params.toString()}`;
        emptyStateSuggestLink.textContent = query ? `Suggest "${query}" as a new concept` : 'Suggest a new concept';
      }
      Object.entries(views).forEach(([key, el]) => {
        if (el) el.hidden = key !== activeSort || activeViewEmpty;
      });

      renderFilterChips();
      writeURLState();
    }

    function clearFilters() {
      searchInput.value = '';
      categoryCheckboxes.forEach((cb) => (cb.checked = true));
      hasCheckboxes.forEach((cb) => (cb.checked = false));
      applyFilters();
    }

    let debounceTimer: ReturnType<typeof setTimeout>;
    searchInput.addEventListener('input', () => {
      clearTimeout(debounceTimer);
      debounceTimer = setTimeout(applyFilters, 120);
    });
    categoryCheckboxes.forEach((cb) => cb.addEventListener('change', applyFilters));
    hasCheckboxes.forEach((cb) => cb.addEventListener('change', applyFilters));
    sortButtons.forEach((btn) =>
      btn.addEventListener('click', () => {
        setActiveSort(btn.dataset.sort as 'category' | 'alphabetical');
        applyFilters();
      })
    );
    densityButtons.forEach((btn) =>
      btn.addEventListener('click', () => {
        setActiveDensity(btn.dataset.density as 'grid' | 'compact');
        writeURLState();
      })
    );
    clearButtons.forEach((btn) => btn.addEventListener('click', clearFilters));
    selectAllCategoriesBtn?.addEventListener('click', () => {
      categoryCheckboxes.forEach((cb) => (cb.checked = true));
      applyFilters();
    });
    clearCategoriesBtn?.addEventListener('click', () => {
      categoryCheckboxes.forEach((cb) => (cb.checked = false));
      applyFilters();
    });

    readURLState();
    setActiveSort(activeSort);
    setActiveDensity(activeDensity);
    applyFilters();
  </script>
</BaseLayout>
